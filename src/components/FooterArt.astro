---
// Footer artwork: a pixel street in Kolkata under a very large wordmark.
// Victoria Memorial in the middle, a tram going one way, a yellow taxi the other.
// Drawn in the page's own colours, so it follows the light and dark themes.
// Click it and the tram rings its bell and hurries.
---
<div class="art" data-art>
  <p class="mark" aria-hidden="true">rijudevx</p>
  <canvas width="232" height="46" role="img" aria-label="Pixel drawing of a Kolkata street: Victoria Memorial, a tram and a yellow taxi." data-cursor="ding ding"></canvas>
</div>

<script>
  import { play } from '../lib/sound';
  const root = document.querySelector<HTMLElement>('[data-art]');
  const cv = root?.querySelector('canvas');
  const ctx = cv?.getContext('2d');
  if (root && cv && ctx) {
    const W = 232, G = 41; // G: the ground line
    let c = { ink: '#fff', muted: '#888', rule: '#333', strong: '#444', paper: '#111', warn: '#e6a83a', dark: true };
    const readColours = () => {
      const s = getComputedStyle(document.documentElement), v = (n: string) => s.getPropertyValue(n).trim();
      c = { ink: v('--ink'), muted: v('--muted'), rule: v('--rule'), strong: v('--rule-strong'), paper: v('--paper'), warn: v('--warn'), dark: document.documentElement.dataset.theme !== 'light' };
    };
    const px = (x: number, y: number, w = 1, h = 1, col?: string) => { if (col) ctx.fillStyle = col; ctx.fillRect(Math.round(x), Math.round(y), w, h); };
    const dome = (cx: number, cy: number, r: number) => { for (let dy = 0; dy <= r; dy++) { const half = Math.round(Math.sqrt(r * r - dy * dy)); px(cx - half, cy - dy, half * 2 + 1, 1); } };

    let seed = 11;
    const rnd = () => ((seed = (seed * 16807) % 2147483647) - 1) / 2147483646;
    const blocks: { x: number; w: number; h: number; win: [number, number][] }[] = [];
    for (const [from, to] of [[4, 66], [166, 228]]) for (let x = from; x < to; ) {
      const w = 5 + Math.floor(rnd() * 7), h = 6 + Math.floor(rnd() * 13);
      const win: [number, number][] = []; for (let k = 0; k < 5; k++) win.push([1 + Math.floor(rnd() * (w - 2)), 2 + Math.floor(rnd() * (h - 3))]);
      blocks.push({ x, w, h, win }); x += w + 1;
    }
    const stars = Array.from({ length: 30 }, () => [Math.floor(rnd() * W), Math.floor(rnd() * 20), rnd() * 6.28] as const);
    let hurry = 0, tramX = 20;

    function draw(sec: number, dt: number) {
      ctx.clearRect(0, 0, W, 46);
      if (c.dark) for (const [sx, sy, ph] of stars) { ctx.globalAlpha = 0.25 + 0.6 * Math.abs(Math.sin(sec * 0.7 + ph)); px(sx, sy, 1, 1, c.muted); }
      ctx.globalAlpha = 1;
      ctx.fillStyle = c.dark ? c.ink : c.warn; px(206, 6, 5, 7); px(205, 7, 7, 5);                 // moon or sun
      // houses on both sides
      for (const b of blocks) { px(b.x, G - b.h, b.w, b.h, c.strong); ctx.fillStyle = c.dark ? c.warn : c.paper; for (const [wx, wy] of b.win) if ((wx + wy + b.x) % 3) px(b.x + wx, G - b.h + wy); }
      // Victoria Memorial
      ctx.fillStyle = c.muted;
      px(90, 30, 53, 11); px(107, 24, 19, 6); dome(116, 24, 7); px(115, 13, 3, 4); px(116, 10, 1, 3); px(115, 11, 3, 1);
      px(90, 25, 7, 5); dome(93, 25, 3); px(136, 25, 7, 5); dome(139, 25, 3);
      ctx.fillStyle = c.paper; for (let x = 93; x < 141; x += 3) px(x, 33, 1, 7); px(114, 34, 5, 7);
      // palms and lamp posts
      for (const x of [78, 154]) { ctx.fillStyle = c.muted; px(x, 28, 1, 13); for (const [dx, dy] of [[-3, 2], [-2, 1], [-1, 0], [0, 0], [1, 0], [2, 1], [3, 2], [-2, 3], [2, 3]]) px(x + dx, 26 + dy); }
      for (const x of [30, 70, 162, 200]) { px(x, 31, 1, 10, c.muted); px(x, 30, 3, 1); px(x + 2, 31, 1, 1, c.warn); if (c.dark) { ctx.globalAlpha = 0.18; px(x + 1, 32, 3, 3, c.warn); ctx.globalAlpha = 1; } }
      // the road and the tram tracks
      px(0, G, W, 1, c.strong); ctx.fillStyle = c.strong; for (let x = 1; x < W; x += 4) px(x, G + 2, 2, 1);
      // tram: two cars, cream over blue
      hurry = Math.max(0, hurry - dt);
      tramX += (5 + (hurry > 0 ? 26 : 0)) * dt; if (tramX > W + 6) tramX = -40;
      for (const off of [0, 18]) {
        const x = tramX + off;
        px(x, 33, 16, 3, '#e8e2d0'); px(x, 36, 16, 4, '#2f5fb3'); px(x, 32, 16, 1, '#1d3f80');
        ctx.fillStyle = c.dark ? '#f6d98a' : '#1b2a44'; for (let k = 2; k < 15; k += 3) px(x + k, 34, 2, 2);
        ctx.fillStyle = '#16181d'; px(x + 2, 40, 3, 1); px(x + 11, 40, 3, 1);
      }
      ctx.fillStyle = c.muted; px(tramX + 7, 29, 1, 3); px(tramX + 5, 29, 5, 1);
      // taxi, the other way
      const tx = W + 12 - ((sec * 11) % (W + 30));
      px(tx, 38, 9, 3, '#f5c518'); px(tx + 2, 36, 5, 2); ctx.fillStyle = '#16181d'; px(tx + 3, 37, 1, 1); px(tx + 5, 37, 1, 1); px(tx + 1, 41, 2, 1); px(tx + 6, 41, 2, 1);
    }

    readColours();
    const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let visible = false, last = 0;
    draw(0, 0);
    new MutationObserver(() => { readColours(); if (still) draw(0, 0); }).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
    if (!still) {
      new IntersectionObserver(([e]) => (visible = e.isIntersecting)).observe(root);
      const loop = (t: number) => { if (visible && t - last > 80) { draw(t / 1000, Math.min(0.2, (t - last) / 1000)); last = t; } requestAnimationFrame(loop); };
      requestAnimationFrame(loop);
    }
    cv.addEventListener('click', () => { hurry = 2.2; play('copy'); setTimeout(() => play('copy'), 260); });
  }
</script>

<style>
  .art { display: grid; align-items: end; margin: 28px calc(-1 * var(--gutter)) 0; overflow: hidden; }
  .art > * { grid-area: 1 / 1; }
  .mark {
    margin: 0 0 0.04em; text-align: center; white-space: nowrap; user-select: none; pointer-events: none;
    font-family: var(--font-serif); font-style: italic; font-weight: 400; font-size: clamp(5rem, 25vw, 16.5rem); line-height: 0.8; letter-spacing: -0.03em;
    color: transparent; -webkit-text-stroke: 1px var(--rule-strong);
  }
  canvas { position: relative; display: block; width: 100%; height: auto; aspect-ratio: 232 / 46; image-rendering: pixelated; cursor: pointer; }
</style>
