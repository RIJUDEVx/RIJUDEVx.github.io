---
// Review-only: jump between home page versions. Remove once one is chosen.
const versions = [
  { label: 'Home', href: '/', note: 'current home' },
  { label: 'Home · simple work', href: '/v/home-simple', note: 'home, Work & now rewritten' },
  { label: 'v1', href: '/v1', note: 'first home' },
  { label: 'Bento', href: '/v/bento', note: 'grid of tiles' },
  { label: 'Editorial', href: '/v/editorial', note: 'two columns' },
  { label: 'Simple', href: '/v/simple', note: 'short note, tl;dr switch' },
];
const here = Astro.url.pathname.replace(/\/$/, '') || '/';
const current = versions.find((v) => v.href === here) ?? versions[0];
---
<details class="vs" data-vs>
  <summary aria-label="Switch page version">
    <span class="mono k">ver</span>
    <span class="cur">{current.label}</span>
    <svg class="chev" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
  </summary>
  <ul class="menu">
    {versions.map((v) => (
      <li>
        <a href={v.href} class:list={{ on: here === v.href }} aria-current={here === v.href ? 'page' : undefined} data-sound="tap">
          <span class="l">{v.label}</span><span class="mono n">{v.note}</span>
        </a>
      </li>
    ))}
  </ul>
</details>

<script>
  // Close on outside click or Escape.
  document.addEventListener('click', (e) => {
    const d = document.querySelector<HTMLDetailsElement>('[data-vs]');
    if (d?.open && !d.contains(e.target as Node)) d.open = false;
  });
  document.addEventListener('keydown', (e) => {
    const d = document.querySelector<HTMLDetailsElement>('[data-vs]');
    if (e.key === 'Escape' && d?.open) { d.open = false; d.querySelector('summary')?.focus(); }
  });
</script>

<style>
  .vs { position: fixed; z-index: 70; top: 14px; right: 16px; }
  summary {
    list-style: none; display: flex; align-items: center; gap: 8px; cursor: pointer; user-select: none;
    padding: 7px 12px 7px 10px; border-radius: 999px; border: 1px solid var(--rule-strong);
    background: color-mix(in oklab, var(--surface) 72%, transparent);
    backdrop-filter: blur(14px) saturate(1.4); -webkit-backdrop-filter: blur(14px) saturate(1.4);
    box-shadow: var(--shadow); font-size: 0.8125rem; color: var(--ink);
  }
  summary::-webkit-details-marker { display: none; }
  .k { font-size: 0.625rem; color: var(--muted); text-transform: uppercase; letter-spacing: 0.08em; }
  .chev { color: var(--muted); transition: transform 0.2s var(--ease); }
  .vs[open] .chev { transform: rotate(180deg); }
  .menu {
    position: absolute; right: 0; top: calc(100% + 8px); width: 260px; list-style: none; margin: 0; padding: 6px;
    border-radius: 14px; border: 1px solid var(--rule-strong); background: var(--surface); box-shadow: var(--shadow);
    animation: drop 0.18s var(--ease);
  }
  @keyframes drop { from { opacity: 0; transform: translateY(-4px) scale(0.98); } }
  .menu a { display: grid; gap: 1px; padding: 8px 10px; border-radius: 9px; text-decoration: none; color: var(--ink); }
  .menu a:hover { background: color-mix(in oklab, var(--ink) 7%, transparent); }
  .menu a.on { background: var(--ink); color: var(--paper); }
  .menu a.on .n { color: color-mix(in oklab, var(--paper) 70%, transparent); }
  .l { font-size: 0.8125rem; font-weight: 500; }
  .n { font-size: 0.625rem; color: var(--muted); }
  @media (max-width: 760px) {
    .vs { top: auto; right: 12px; bottom: calc(96px + env(safe-area-inset-bottom)); }
    .menu { top: auto; bottom: calc(100% + 8px); }
  }
  @media (prefers-reduced-motion: reduce) { .menu { animation: none; } }
</style>
