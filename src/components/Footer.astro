---
import Clock from './Clock.svelte';
import FooterArt from './FooterArt.astro';
import { profile, links } from '../data/site';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <p class="greet" data-greeting></p>
  <p class="mono">© {year} {profile.name} <span class="nw">· <Clock client:idle variant="footer" /></span></p>
  <ul>
    {links.map((l) => <li><a class="mono" href={l.href} data-sound="tap">{l.label.toLowerCase()}</a></li>)}
    <li><a class="mono" href="/llms.txt">llms.txt</a></li>
  </ul>
  <p class="mono status"><i aria-hidden="true"></i>all systems operational <span class="nw">· you have been here <span data-here>0s</span></span> <span class="nw">· 0 incidents</span></p>
  <p class="mono player">
    <button type="button" data-music aria-pressed="false"><span class="eq" aria-hidden="true"><i></i><i></i><i></i><i></i></span><span data-music-label>play the 8-bit loop</span></button>
    <span class="sep">·</span>
    <button type="button" data-mute aria-pressed="false">sound on</button>
  </p>
  <p class="mono hint">press <kbd>⌘</kbd> <kbd>K</kbd> to jump anywhere</p>
  <p class="mono hint">psst, this is a backend dev's site. press <kbd>D</kbd> to deploy</p>
  <FooterArt />
</footer>

<script>
  // Greeting depends on the visitor's local hour, so it can only be set in the browser.
  function greet() {
    const el = document.querySelector<HTMLElement>('[data-greeting]');
    if (!el) return;
    const h = new Date().getHours();
    el.textContent =
      h >= 5 && h <= 11 ? "up early? go have breakfast first :)"
      : h >= 12 && h <= 16 ? "shouldn't you be working right now? :)"
      : h >= 17 && h <= 20 ? "done for the day? go do something fun :)"
      : "up this late? go get some sleep :)";
  }
  greet();
  document.addEventListener('astro:page-load', greet);

  // How long this visit has lasted, status-page style.
  const here = document.querySelector<HTMLElement>('[data-here]');
  const t0 = Date.now();
  if (here) setInterval(() => { const s = Math.floor((Date.now() - t0) / 1000); here.textContent = s < 60 ? `${s}s` : `${Math.floor(s / 60)}m ${s % 60}s`; }, 1000);

  // Music and sound switches.
  import { setMusic, musicPlaying, resumeMusic, isMuted, setMuted } from '../lib/sound';
  const mBtn = document.querySelector<HTMLButtonElement>('[data-music]');
  const mLabel = document.querySelector<HTMLElement>('[data-music-label]');
  const muteBtn = document.querySelector<HTMLButtonElement>('[data-mute]');
  const paintMusic = () => {
    const on = musicPlaying();
    mBtn?.setAttribute('aria-pressed', String(on)); mBtn?.classList.toggle('on', on);
    if (mLabel) mLabel.textContent = on ? 'now playing: hooghly loop · stop' : 'play the 8-bit loop';
  };
  const paintMute = () => { if (muteBtn) { muteBtn.textContent = isMuted() ? 'sound off' : 'sound on'; muteBtn.setAttribute('aria-pressed', String(isMuted())); } };
  mBtn?.addEventListener('click', () => setMusic(!musicPlaying()));
  muteBtn?.addEventListener('click', () => setMuted(!isMuted()));
  addEventListener('music:change', paintMusic); addEventListener('sound:change', paintMute);
  paintMute(); resumeMusic();

  // Press D: a pretend deploy runs in the corner. Nothing is deployed.
  import { play } from '../lib/sound';
  let busy = false;
  document.addEventListener('keydown', (e) => {
    const t = e.target as HTMLElement | null;
    if (busy || e.key.toLowerCase() !== 'd' || e.metaKey || e.ctrlKey || e.altKey || e.repeat) return;
    if (t && (t.closest('input, textarea, select, [contenteditable], [role="dialog"]'))) return;
    busy = true;
    const friday = new Date().getDay() === 5;
    const lines = ['$ git push origin main', '✓ lint   ✓ types   ✓ tests', '✓ migrations applied', friday ? '✓ deployed to prod. on a friday. bold.' : '✓ deployed to prod', 'nothing broke. back to work.'];
    const box = document.createElement('div');
    box.className = 'deploy mono'; box.setAttribute('role', 'status');
    document.body.appendChild(box);
    play('open');
    lines.forEach((l, i) => setTimeout(() => {
      const p = document.createElement('p'); p.textContent = l; if (l.startsWith('✓')) p.className = 'ok';
      box.appendChild(p);
      play(i === lines.length - 2 ? 'win' : 'tap');
    }, 150 + i * 520));
    setTimeout(() => box.classList.add('out'), 150 + lines.length * 520 + 1800);
    setTimeout(() => { box.remove(); busy = false; }, 150 + lines.length * 520 + 2200);
  });
</script>

<style>
  .site-footer { padding: 40px var(--gutter) 0; border-top: 1px solid var(--rule); display: grid; gap: 12px; color: var(--muted); }
  p { margin: 0; }
  .greet { font-size: 0.8125rem; color: var(--text); min-height: 1.65em; }
  ul { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 4px 16px; }
  a { color: var(--muted); text-decoration: none; }
  a:hover { color: var(--ink); }
  kbd { font-family: var(--font-mono); font-size: 0.6875rem; border: 1px solid var(--rule-strong); border-bottom-width: 2px; border-radius: 4px; padding: 0 5px; }
  .status { font-variant-numeric: tabular-nums; }
  .nw { white-space: nowrap; }
  .status i { display: inline-block; margin-right: 9px; vertical-align: 1px; width: 7px; height: 7px; border-radius: 50%; background: var(--ok); box-shadow: 0 0 0 3px color-mix(in oklab, var(--ok) 20%, transparent); }
  .player { display: flex; align-items: center; gap: 8px; }
  .player button { display: inline-flex; align-items: center; gap: 8px; border: 0; background: none; padding: 0; cursor: pointer; font: inherit; color: var(--text); }
  .player button:hover { color: var(--ink); }
  .eq { display: inline-flex; align-items: flex-end; gap: 2px; height: 10px; }
  .eq i { width: 2px; height: 3px; background: currentColor; }
  .on .eq i { animation: eq 0.6s steps(4) infinite alternate; }
  .on .eq i:nth-child(2) { animation-delay: -0.2s; } .on .eq i:nth-child(3) { animation-delay: -0.45s; } .on .eq i:nth-child(4) { animation-delay: -0.1s; }
  .on { color: var(--ok) !important; }
  @keyframes eq { to { height: 10px; } }
  @media (hover: none) { .hint { display: none; } }
  :global(.deploy) {
    position: fixed; left: 20px; bottom: 20px; z-index: 80; min-width: 300px; padding: 14px 16px; border-radius: 12px;
    background: #0d0d0c; color: #e9e7df; border: 1px solid #33332f; box-shadow: 0 24px 60px -20px rgb(0 0 0 / 0.7);
    font-size: 0.75rem; line-height: 1.7; animation: deploy-in 0.3s cubic-bezier(0.34, 1.4, 0.64, 1); transition: opacity 0.3s, transform 0.3s;
  }
  :global(.deploy p) { margin: 0; white-space: pre; animation: deploy-line 0.2s ease-out; }
  :global(.deploy .ok) { color: #3ecf7a; }
  :global(.deploy.out) { opacity: 0; transform: translateY(8px); }
  @keyframes deploy-in { from { opacity: 0; transform: translateY(12px) scale(0.96); } }
  @keyframes deploy-line { from { opacity: 0; transform: translateX(-4px); } }
</style>
