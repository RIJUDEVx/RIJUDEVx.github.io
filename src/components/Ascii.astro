---
// ASCII portrait. Rendered as real text (so it's crisp at any size and selectable),
// it "decodes" into place on first view and scrambles near the cursor.
import { portrait } from '../data/portrait';
interface Props { class?: string }
const { class: cls } = Astro.props;
---
<figure class:list={['ascii', cls]} aria-label="ASCII portrait of Riju Dev Purkayastha">
  <pre data-ascii aria-hidden="true">{portrait}</pre>
</figure>

<script>
  const RAMP = ' .,:;-=+*x#%@';
  function run() {
    document.querySelectorAll<HTMLPreElement>('pre[data-ascii]').forEach((pre) => {
      if (pre.dataset.ready) return;
      pre.dataset.ready = '1';
      const target = pre.textContent ?? '';
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (reduce) return;
      const chars = [...target];
      // Decode: every non-space settles after a random delay.
      const settle = chars.map((c) => (c === ' ' || c === '\n' ? 0 : 200 + Math.random() * 900));
      const t0 = performance.now();
      const step = (t: number) => {
        const dt = t - t0;
        let done = true;
        let out = '';
        for (let i = 0; i < chars.length; i++) {
          const c = chars[i];
          if (c === '\n' || c === ' ' || dt >= settle[i]) out += c;
          else { done = false; out += RAMP[(Math.random() * RAMP.length) | 0]; }
        }
        pre.textContent = out;
        if (!done) requestAnimationFrame(step);
      };
      requestAnimationFrame(step);

      // Cursor scramble: characters near the pointer flicker, then restore.
      if (!matchMedia('(pointer: fine)').matches) return;
      const lines = target.split('\n');
      let raf = 0;
      pre.addEventListener('pointermove', (e) => {
        const r = pre.getBoundingClientRect();
        const cw = r.width / Math.max(...lines.map((l) => l.length));
        const lh = r.height / lines.length;
        const cx = (e.clientX - r.left) / cw, cy = (e.clientY - r.top) / lh;
        cancelAnimationFrame(raf);
        raf = requestAnimationFrame(() => {
          pre.textContent = lines.map((line, y) => [...line].map((c, x) => {
            if (c === ' ') return c;
            const d = Math.hypot((x - cx) * 0.5, y - cy);
            return d < 3.2 && Math.random() > 0.35 ? RAMP[(Math.random() * RAMP.length) | 0] : c;
          }).join('')).join('\n');
        });
      });
      pre.addEventListener('pointerleave', () => { cancelAnimationFrame(raf); pre.textContent = target; });
    });
  }
  run();
  document.addEventListener('astro:page-load', run);
</script>

<style>
  .ascii { margin: 0; }
  pre {
    margin: 0; font-family: var(--font-mono); font-size: 6.4px; line-height: 1.05; letter-spacing: 0.02em;
    color: var(--ink); white-space: pre; user-select: none;
    background: linear-gradient(180deg, var(--ink) 30%, color-mix(in oklab, var(--ink) 40%, transparent));
    -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent;
  }
</style>
