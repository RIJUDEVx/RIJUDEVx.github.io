---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Cursor from '../components/Cursor.svelte';
import SmoothScroll from '../components/SmoothScroll.svelte';
import CommandPalette from '../components/CommandPalette.svelte';
import Seo from '../components/Seo.astro';
import { profile } from '../data/site';
import type { FaqItem, VideoMeta, WorkMeta } from '../lib/types';

interface Props {
  title?: string;
  description?: string;
  intro?: boolean;
  page?: 'home' | 'work';
  faq?: FaqItem[];
  work?: WorkMeta;
  video?: VideoMeta;
  noindex?: boolean;
}
const { title, description = `${profile.name}, ${profile.title}. ${profile.tagline}`, page = 'home', faq, work, video, noindex = false } = Astro.props;
// Browser title is just the GitHub handle (Riju's call, 13 Nov 2026). The full name stays in og/meta/JSON-LD.
const fullTitle = title ? `${title} · ${profile.handle}` : profile.handle;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <Seo title={fullTitle} description={description} page={page} faq={faq} work={work} video={video} noindex={noindex} />
    <script is:inline>
      // Set the theme before first paint so there's no flash.
      (function () {
        var t = null;
        try { t = localStorage.getItem('rd:theme'); } catch (e) {}
        if (!t) t = 'dark'; // dark by default; the toggle remembers a choice
        document.documentElement.dataset.theme = t;
        // First visit this session on the home page: Intro.svelte plays.
        var seen = null;
        try { seen = sessionStorage.getItem('rd:intro'); } catch (e) {}
        if (!seen && location.pathname === '/' && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
          document.documentElement.dataset.intro = 'pending';
          // Count visits (one per session). The first gets the name intro; later ones get a shorter, different loader.
          var n = 0;
          try { n = (parseInt(localStorage.getItem('rd:visits') || '0', 10) || 0) + 1; localStorage.setItem('rd:visits', String(n)); } catch (e) {}
          document.documentElement.dataset.introKind = n <= 1 ? 'name' : n % 2 === 0 ? 'boot' : 'again';
        }
      })();
      document.addEventListener('astro:after-swap', function () {
        var t = null;
        try { t = localStorage.getItem('rd:theme'); } catch (e) {}
        if (t) document.documentElement.dataset.theme = t;
      });
    </script>
    <script is:inline>
      // Tab title and favicon change while the tab is hidden. Listeners sit on
      // document, so they survive ClientRouter swaps; the title and icon are
      // re-read on astro:page-load so the restored values match the current page.
      (function () {
        if (window.__rdAway) return;
        window.__rdAway = true;
        var AWAY = ["brb? the build's still running.", 'come back, prod is lonely.', 'psst. the tests passed.', 'still here. still compiling.', 'your tab misses you.', 'i was mid-sentence.'];
        var BACK = "oh, you're back.";
        var AWAY_ICON = '/favicon-away.svg';
        var home = { title: document.title, icon: '/favicon.svg' };
        var turn = 0, wasAway = false, backTimer = 0;
        function iconEl() { return document.querySelector('link[rel="icon"][type="image/svg+xml"]'); }
        function remember() {
          if (AWAY.indexOf(document.title) < 0 && document.title !== BACK) home.title = document.title;
          var el = iconEl();
          if (el && el.getAttribute('href') !== AWAY_ICON) home.icon = el.getAttribute('href');
        }
        var blurred = false;
        function apply() {
          var el = iconEl();
          clearTimeout(backTimer);
          if (document.hidden || blurred) {
            if (!wasAway) { wasAway = true; document.title = AWAY[turn++ % AWAY.length]; } // a different line each time
            if (el) el.setAttribute('href', AWAY_ICON);
          } else {
            if (el) el.setAttribute('href', home.icon);
            if (wasAway) { wasAway = false; document.title = BACK; backTimer = setTimeout(function () { document.title = home.title; }, 1600); }
            else document.title = home.title;
          }
        }
        document.addEventListener('visibilitychange', function () { remember(); apply(); });
        // Also when the window loses focus (another app or window in front), not just hidden tabs.
        window.addEventListener('blur', function () { remember(); blurred = true; apply(); });
        window.addEventListener('focus', function () { blurred = false; apply(); });
        document.addEventListener('astro:page-load', function () { remember(); apply(); });
        remember();
        apply();
      })();
    </script>
  </head>
  <body>
    <a class="skip pill" href="#main">Skip to content</a>
    <slot name="intro" />
    <div class="page">
      <Header />
      <main id="main">
        <slot />
      </main>
      <Footer />
    </div>
    <Cursor client:only="svelte" />
    <SmoothScroll client:only="svelte" />
    <CommandPalette client:idle />
    <script>
      import { play, type SoundName } from '../lib/sound';
      // Any element with data-sound="name" plays that sound when clicked.
      document.addEventListener('click', (e) => {
        const el = (e.target as HTMLElement).closest<HTMLElement>('[data-sound]');
        if (el?.dataset.sound) play(el.dataset.sound as SoundName);
      });
      // A very quiet tick when the mouse arrives on something you can press.
      let lastHover: Element | null = null;
      document.addEventListener('pointerover', (e) => {
        if (e.pointerType !== 'mouse') return;
        const el = (e.target as Element).closest?.('a, button, [data-sound]') ?? null;
        if (el && el !== lastHover) play('hover');
        lastHover = el;
      }, { passive: true });

      // Copying text gets a small toast.
      const QUIPS = ['copied. quote me on that :)', 'copied. cite your sources.', 'copied. good taste.'];
      let quip = 0;
      document.addEventListener('copy', () => {
        if (!String(getSelection() ?? '').trim()) return;
        document.querySelector('.toast')?.remove();
        const t = document.createElement('div');
        t.className = 'toast mono'; t.setAttribute('role', 'status'); t.textContent = QUIPS[quip++ % QUIPS.length];
        document.body.appendChild(t);
        setTimeout(() => t.classList.add('out'), 1800); setTimeout(() => t.remove(), 2200);
      });

      // For whoever opens the console.
      console.log('%c rd %c hi, fellow inspector.', 'background:#faf9f5;color:#141413;font:600 14px Georgia,serif;padding:2px 6px;border-radius:4px', 'font:13px ui-monospace,monospace');
      console.log('%cthe source is tidy, I promise. press D on the page to deploy, ⌘K to jump around.\nsay hi: rijudev12@gmail.com', 'font:12px ui-monospace,monospace;color:#87867f');
    </script>
  </body>
</html>
