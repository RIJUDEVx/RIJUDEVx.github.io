---
// Home. A mix of the three drafts:
//  - Index (C): a first-person statement hero and the work as a numbered index
//    with a cursor-trailing preview, covering every project equally.
//  - Bento (B): an "at a glance" grid for everything that isn't a project.
//  - Editorial (A): restraint, mono section labels, no ornament for its own sake.
// Phones get iOS grouped lists and cards (see the 760px block at the bottom).
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Intro from '../components/Intro.svelte';
import Ascii from '../components/Ascii.astro';
import CutLine from '../components/CutLine.svelte';
import Clock from '../components/Clock.svelte';
import CopyEmail from '../components/CopyEmail.svelte';
import Questions from '../components/Questions.svelte';
import Pipeline from '../components/Pipeline.svelte';
import GitHubGraph from '../components/GitHubGraph.astro';
import Brand from '../components/Brand.astro';
import { profile, links, questions, experience, statusLabel, stackIcons, education } from '../data/site';

const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
const writing = await getCollection('writing');
const social = links.filter((l) => l.brand);
const year = (y: string) => (y.match(/\d{4}/g) ?? []).join('–').replace(/^(\d{4})–\1$/, '$1') || '—';
---
<Base page="home" faq={questions}>
  <Intro slot="intro" client:load name={profile.name} />

  <section class="hero" id="top">
    <Ascii class="portrait" />
    <div class="copy">
      <p class="eyebrow mono"><span>{profile.handle}</span><span class="sep">/</span><Clock client:load variant="footer" /></p>
      <h1>
        I'm Riju. I build backend platforms, Salesforce tooling and native apps,{' '}
        <span class="dim">and lead the team behind Selegic CRM.</span>
      </h1>
      <p class="sub">{profile.title} at <a href={profile.company.url} target="_blank" rel="noopener">Selegic India</a> · 4+ years · {work.length} projects</p>
      <div class="cta">
        <CopyEmail client:load email={profile.email} big />
        <a class="pill" href="/resume.pdf" data-sound="tap">Resume</a>
        <span class="soc">{social.map((l) => <a class="icon" href={l.href} target="_blank" rel="noopener me" aria-label={l.label} data-sound="tap"><Brand name={l.brand!} mono size={16} /></a>)}</span>
      </div>
    </div>
  </section>

  <div class="about-wrap">
    <CutLine client:visible label="Cut along the line to read more">
      <div class="prose" id="about">
        <p>I started at Selegic as an intern in January 2022, building a Chrome extension and Salesforce admin tools. Since then I've shipped native iOS apps, Migrata on Salesforce AppExchange, the company's time-tracking platform, and Selegic CRM, which I designed and now lead.</p>
        <p>The thread through all of it is the backend: data that stays correct, access control that holds, and releases nobody has to hold their breath for. I'm happiest owning a system end to end, from the schema to the deploy.</p>
        <p class="mono muted">{profile.workModes}</p>
      </div>
    </CutLine>
  </div>

  <section class="index" id="work" data-index>
    <div class="label-row"><h2 class="label mono">Work</h2><span class="mono muted">{work.length} projects · 2022 – now</span></div>
    <div class="ih mono" aria-hidden="true"><span></span><span>Project</span><span>Area</span><span>Status</span><span>Year</span></div>
    <ol>
      {work.map((w, i) => (
        <li>
          <a href={`/work/${w.id}`} data-preview={`/og/work/${w.id}.png`} data-cursor="open" data-sound="tap">
            <span class="mono n">{String(i + 1).padStart(2, '0')}</span>
            <span class="ttl" transition:name={`title-${w.id}`}>{w.data.title}</span>
            <span class="area">{w.data.area}</span>
            <span class="mono st" data-tone={statusLabel[w.data.status].tone}>{statusLabel[w.data.status].text}</span>
            <span class="mono yr">{year(w.data.years)}</span>
            <span class="sum">{w.data.summary}</span>
          </a>
        </li>
      ))}
    </ol>
    <img class="float" alt="" aria-hidden="true" width="1200" height="630" />
  </section>

  <section class="glance" id="glance" data-spotlight>
    <h2 class="label mono">At a glance</h2>
    <div class="grid">
      <div class="t ask" id="ask"><Questions client:visible questions={questions} /></div>

      <div class="t now">
        <span class="k mono">Now</span>
        <p class="big"><Clock client:load variant="hero" /></p>
        <p class="small muted">Leading the Selegic CRM team. Writing about how we ship.</p>
      </div>

      <div class="t edu">
        <span class="k mono">Education</span>
        <p class="small ink">B.Tech, Computer Science</p>
        <p class="small muted">MAKAUT · {education.years}</p>
      </div>

      <div class="t xp" id="experience">
        <div class="xp-head"><span class="k mono">Experience</span><span class="mono muted small">{experience.dates}</span></div>
        <h3>{experience.role} <span class="muted">· {experience.company}</span></h3>
        <ul>{experience.long.map((l) => <li>{l}</li>)}</ul>
      </div>

      <div class="t gh"><GitHubGraph user="RIJUDEVx" /></div>

      <div class="t writing">
        <div class="xp-head"><span class="k mono">Writing</span><span class="mono muted small">drafts</span></div>
        <ul class="posts">
          {writing.map((p) => (
            <li><a href={`/writing/${p.id}`} data-sound="tap"><span class="pt">{p.data.title}</span><span class="badge">Draft</span></a></li>
          ))}
        </ul>
      </div>

      <div class="t stack">
        <span class="k mono">Stack I reach for</span>
        <div class="marquee" aria-label="Tech stack">
          <div class="track">
            {[...stackIcons, ...stackIcons].map((s) => <span class="chip"><Brand name={s.icon} size={15} />{s.label}</span>)}
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="play" id="pipeline">
    <div class="label-row"><h2 class="label mono">Playground</h2><span class="mono muted">a toy version of what I build</span></div>
    <p class="play-lead">Drag a deal to the next stage and close it.</p>
    <Pipeline client:visible />
  </section>

  <section class="contact" id="contact">
    <h2 class="label mono">Contact</h2>
    <p class="statement">Building something that needs a backend owned end to end?{' '}<span class="dim">I'd like to hear about it.</span></p>
    <div class="cta">
      <CopyEmail client:visible email={profile.email} big />
      <a class="pill" href={links.find((l) => l.label === 'LinkedIn')!.href} target="_blank" rel="noopener" data-sound="tap"><Brand name="linkedin" mono size={14} />LinkedIn</a>
    </div>
  </section>

  <script>
    // Floating preview that trails the cursor over the work index (fine pointers only).
    function index() {
      const root = document.querySelector<HTMLElement>('[data-index]');
      const img = root?.querySelector<HTMLImageElement>('.float');
      if (!root || !img || root.dataset.bound || !matchMedia('(pointer: fine)').matches) return;
      root.dataset.bound = '1';
      let x = 0, y = 0, tx = 0, ty = 0, raf = 0;
      const loop = () => { x += (tx - x) * 0.18; y += (ty - y) * 0.18; img.style.transform = `translate3d(${x}px, ${y}px, 0)`; raf = requestAnimationFrame(loop); };
      root.querySelectorAll<HTMLAnchorElement>('a[data-preview]').forEach((a) => {
        a.addEventListener('pointerenter', () => { img.src = a.dataset.preview!; img.classList.add('on'); });
        a.addEventListener('pointerleave', () => img.classList.remove('on'));
      });
      root.addEventListener('pointermove', (e) => { tx = e.clientX + 28; ty = e.clientY - 100; if (!raf) loop(); });
    }
    // One spotlight across the bento grid.
    function spot() {
      const g = document.querySelector<HTMLElement>('[data-spotlight]');
      if (!g || g.dataset.bound || !matchMedia('(pointer: fine)').matches) return;
      g.dataset.bound = '1';
      g.addEventListener('pointermove', (e) => {
        for (const t of g.querySelectorAll<HTMLElement>('.t')) {
          const r = t.getBoundingClientRect();
          t.style.setProperty('--x', `${e.clientX - r.left}px`);
          t.style.setProperty('--y', `${e.clientY - r.top}px`);
        }
      });
    }
    const init = () => { index(); spot(); };
    init();
    document.addEventListener('astro:page-load', init);
  </script>
</Base>

<style>
  :global(.page) { max-width: 1120px !important; }
  .label { font-size: 0.6875rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); font-weight: 500; }
  .label-row { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; margin-bottom: 18px; }
  .label-row .mono { font-size: 0.6875rem; }
  .dim { color: var(--muted); }
  .ink { color: var(--ink); }
  .small { font-size: 0.8125rem; }

  /* Hero */
  .hero { display: grid; grid-template-columns: auto 1fr; gap: 56px; align-items: center; padding: 112px 24px 32px; }
  .portrait :global(pre) { font-size: 7px; }
  .eyebrow { display: flex; flex-wrap: wrap; gap: 8px; color: var(--muted); font-size: 0.75rem; margin: 0; }
  .sep { opacity: 0.4; }
  h1 { margin-top: 22px; font-size: clamp(2rem, 3.8vw, 3.1rem); font-weight: 600; letter-spacing: -0.04em; line-height: 1.08; max-width: 20ch; }
  .sub { margin: 18px 0 0; color: var(--text); font-size: 0.9375rem; }
  .sub a { color: var(--ink); text-decoration-color: var(--rule-strong); }
  .cta { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin-top: 26px; }
  .soc { display: contents; }
  .icon { width: 36px; height: 36px; border-radius: 50%; display: grid; place-items: center; color: var(--text); border: 1px solid var(--rule); transition: color 0.15s, border-color 0.15s; }
  .icon:hover { color: var(--ink); border-color: var(--rule-strong); }
  .about-wrap { padding: 8px 24px 0; max-width: 760px; }
  .prose p { color: var(--text); line-height: 1.75; margin: 0 0 14px; }

  /* Work index */
  .index { position: relative; padding: 88px 24px 0; }
  .ih { display: grid; grid-template-columns: 48px 1fr 170px 150px 110px; padding-bottom: 10px; color: var(--muted); font-size: 0.6875rem; text-transform: uppercase; letter-spacing: 0.1em; border-bottom: 1px solid var(--rule); }
  ol { list-style: none; margin: 0; padding: 0; }
  li a { display: grid; grid-template-columns: 48px 1fr 170px 150px 110px; align-items: baseline; row-gap: 4px; padding: 18px 0; border-bottom: 1px solid var(--rule); text-decoration: none; color: var(--ink); transition: color 0.2s, padding 0.3s var(--ease); }
  .n, .yr { color: var(--muted); font-size: 0.75rem; }
  .ttl { font-size: clamp(1.4rem, 2.6vw, 2rem); font-weight: 500; letter-spacing: -0.035em; line-height: 1.1; }
  .area { font-size: 0.875rem; color: var(--text); }
  .st { font-size: 0.75rem; color: var(--muted); }
  .st[data-tone='ok'] { color: var(--ok); } .st[data-tone='pilot'] { color: var(--accent); }
  .sum { grid-column: 2 / 5; color: var(--muted); font-size: 0.875rem; max-width: 60ch; max-height: 0; overflow: hidden; opacity: 0; transition: max-height 0.35s var(--ease), opacity 0.25s; }
  ol:hover li a { color: var(--muted); }
  ol li a:hover, ol li a:focus-visible { color: var(--ink); padding-left: 8px; }
  ol li a:hover .sum, ol li a:focus-visible .sum { max-height: 4em; opacity: 1; }
  .float { position: fixed; left: 0; top: 0; width: 300px; height: auto; border-radius: 12px; pointer-events: none; z-index: 40; opacity: 0; scale: 0.92; transition: opacity 0.2s, scale 0.3s var(--ease); box-shadow: 0 24px 60px -20px rgb(0 0 0 / 0.6); }
  .float:global(.on) { opacity: 1; scale: 1; }

  /* At a glance (bento) */
  .glance { padding: 96px 24px 0; }
  .glance > .label { margin-bottom: 18px; }
  .grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; }
  .t { position: relative; overflow: hidden; display: flex; flex-direction: column; gap: 8px; padding: 22px; border-radius: 20px; background: var(--surface); border: 1px solid var(--rule); }
  .t::before { content: ''; position: absolute; inset: 0; pointer-events: none; opacity: 0; transition: opacity 0.3s; background: radial-gradient(340px circle at var(--x, 50%) var(--y, 50%), color-mix(in oklab, var(--accent) 9%, transparent), transparent 60%); }
  .grid:hover .t::before { opacity: 1; }
  .t > * { position: relative; }
  .k { font-size: 0.6875rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--muted); }
  .t p { margin: 0; }
  .ask, .xp, .gh, .writing, .stack { grid-column: span 2; }
  .ask :global(h2) { font-size: 1.125rem !important; }
  .now .big { font-size: 1rem; color: var(--ink); margin-top: 8px; }
  .now .small { margin-top: auto; }
  .edu .small:first-of-type { margin-top: auto; }
  .xp-head { display: flex; justify-content: space-between; align-items: baseline; gap: 8px; }
  .xp h3 { font-size: 1rem; font-weight: 600; letter-spacing: -0.01em; }
  .xp ul { margin: 4px 0 0; padding-left: 16px; display: grid; gap: 6px; font-size: 0.8125rem; line-height: 1.55; color: var(--text); }
  .xp ul li::marker { color: var(--rule-strong); }
  .gh :global(svg) { max-width: 100%; }
  .posts { list-style: none; margin: 4px 0 0; padding: 0; display: grid; }
  .posts a { display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 10px 0; border-bottom: 1px solid var(--rule); text-decoration: none; color: var(--ink); font-size: 0.9375rem; letter-spacing: -0.01em; }
  .posts li:last-child a { border-bottom: 0; }
  .posts a:hover .pt { text-decoration: underline; text-decoration-color: var(--rule-strong); text-underline-offset: 3px; }
  .marquee { overflow: hidden; margin: auto -22px 0; mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent); }
  .track { display: flex; gap: 8px; width: max-content; animation: slide 40s linear infinite; padding: 6px 0; }
  .stack:hover .track { animation-play-state: paused; }
  @keyframes slide { to { transform: translateX(-50%); } }
  .chip { display: inline-flex; align-items: center; gap: 8px; padding: 6px 12px; border-radius: 999px; border: 1px solid var(--rule); background: var(--paper); font-size: 0.8125rem; color: var(--ink); white-space: nowrap; }

  .play { padding: 96px 24px 0; }
  .play-lead { margin: -8px 0 18px; color: var(--muted); font-size: 0.875rem; }
  .contact { padding: 96px 24px 72px; display: grid; gap: 16px; }
  .statement { margin: 0; font-size: clamp(1.5rem, 3vw, 2.25rem); font-weight: 500; letter-spacing: -0.035em; line-height: 1.15; color: var(--ink); max-width: 24ch; }

  @media (max-width: 960px) {
    .hero { grid-template-columns: 1fr; gap: 28px; padding-top: 96px; }
    .portrait :global(pre) { font-size: 5.4px; }
    .ih { display: none; }
    li a { grid-template-columns: 40px 1fr auto; }
    .area, .yr { display: none; }
    .sum { grid-column: 2 / 4; max-height: none; opacity: 1; }
    .grid { grid-template-columns: repeat(2, 1fr); }
  }

  /* Phones: iOS grouped lists and cards, system font and colours come from global.css. */
  @media (max-width: 760px) {
    .hero { padding: 72px 16px 8px; justify-items: center; text-align: center; }
    .portrait :global(pre) { font-size: 4.6px; }
    .eyebrow { justify-content: center; }
    h1 { font-size: 1.875rem; font-weight: 700; letter-spacing: -0.03em; margin-inline: auto; }
    .sub { font-size: 0.9375rem; color: var(--muted); }
    .cta { justify-content: center; gap: 8px; }
    .soc { display: flex; flex-basis: 100%; justify-content: center; gap: 10px; margin-top: 4px; }
    .cta :global(.copy.pill) { background: var(--accent); color: #fff; border: 0; }
    .icon { width: 36px; height: 36px; border: 0; background: rgb(127 127 127 / 0.14); color: var(--ink); }
    .about-wrap { padding: 8px 16px 0; }

    .index, .glance, .play { padding: 40px 16px 0; }
    .label { font-size: 0.8125rem; letter-spacing: 0.02em; text-transform: none; color: var(--muted); padding-left: 16px; }
    .label-row .mono { display: none; }
    ol { background: var(--surface); border-radius: 20px; overflow: hidden; }
    li a { grid-template-columns: 1fr auto; padding: 14px 40px 14px 16px; position: relative; border-bottom: 0.5px solid var(--rule-strong); }
    li:last-child a { border-bottom: 0; }
    li a::after { content: ''; position: absolute; right: 18px; top: 50%; width: 8px; height: 8px; border-right: 2px solid var(--rule-strong); border-top: 2px solid var(--rule-strong); transform: translateY(-50%) rotate(45deg); }
    li a:active { background: rgb(127 127 127 / 0.12); }
    ol:hover li a { color: var(--ink); }
    ol li a:hover { padding-left: 16px; }
    .n { display: none; }
    .ttl { font-size: 1.0625rem; font-weight: 600; letter-spacing: -0.01em; }
    .st { font-family: var(--font-sans); font-size: 0.8125rem; }
    .sum { grid-column: 1 / 3; font-size: 0.875rem; }
    .float { display: none; }

    .grid { grid-template-columns: 1fr; gap: 12px; }
    .ask, .xp, .gh, .writing, .stack { grid-column: auto; }
    .t { border: 0; border-radius: 20px; padding: 16px; }
    .k { font-family: var(--font-sans); text-transform: none; letter-spacing: 0; font-size: 0.8125rem; font-weight: 600; }
    .contact { padding: 40px 16px 32px; }
    .contact .cta { display: grid; grid-template-columns: 1fr; }
    .contact .cta > :global(*) { justify-content: center; }
    .statement { font-size: 1.5rem; font-weight: 700; }
  }
</style>
