---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Intro from '../components/Intro.svelte';
import Clock from '../components/Clock.svelte';
import CopyEmail from '../components/CopyEmail.svelte';
import Questions from '../components/Questions.svelte';
import Preview from '../components/Preview.svelte';
import ExperienceToggle from '../components/ExperienceToggle.svelte';
import Pipeline from '../components/Pipeline.svelte';
import GitHubGraph from '../components/GitHubGraph.astro';
import Icon from '../components/Icon.astro';
import { profile, links, questions, previews, experience, stack, statusLabel } from '../data/site';

const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
---
<Base>
  <Intro slot="intro" client:load name={profile.name} />

  <section class="hero">
    <div class="identity">
      <div class="avatar" aria-hidden="true"><span class="display">rd</span></div>
      <div>
        <h1 class="display" transition:name="name">{profile.name}</h1>
        <p class="tagline">{profile.tagline}</p>
      </div>
    </div>

    <ul class="facts">
      <li><Icon name="code" /><span>{profile.title} at <a href={profile.company.url}>{profile.company.name}</a></span></li>
      <li><Icon name="clock" /><Clock client:load variant="hero" /></li>
      <li><Icon name="pin" /><span>{profile.city}</span></li>
      <li><Icon name="mail" /><CopyEmail client:load email={profile.email} /></li>
    </ul>

    <p class="avail"><span class="badge" data-tone="ok">{profile.availability}</span> <span class="mono muted">{profile.workModes}</span></p>

    <nav class="links" aria-label="Elsewhere">
      {links.map((l) => <a class="pill" href={l.href} data-sound="tap" target={l.href.startsWith('http') ? '_blank' : undefined} rel="noopener"><Icon name={l.icon} />{l.label}</a>)}
    </nav>

    <Questions client:visible questions={questions} />
  </section>

  <section class="section" id="about">
    <div class="section-head"><h2>about</h2><span class="mono">01</span></div>
    <div class="prose">
      <p>
        I'm a backend-focused full-stack engineer with 4+ years at Selegic. I designed and built{' '}
        <Preview client:visible {...previews.crm} statusText={statusLabel[previews.crm.status].text} tone={statusLabel[previews.crm.status].tone}>Selegic CRM</Preview>{' '}
        from an empty repo, took it to its first release on my own in five months, and now lead the team that builds it.
      </p>
      <p>
        Along the way I built{' '}
        <Preview client:visible {...previews.migrata} statusText={statusLabel[previews.migrata.status].text} tone={statusLabel[previews.migrata.status].tone}>Migrata</Preview>, which replaced manual Salesforce CPQ deployments and now lives on AppExchange, and{' '}
        <Preview client:visible {...previews.internal} statusText={statusLabel[previews.internal.status].text} tone={statusLabel[previews.internal.status].tone}>the platform</Preview>{' '}
        the whole company tracks its time on. Before that, native iOS apps.
      </p>
      <p>I care about systems that stay correct when real people use them: access control, clean data, and releases nobody has to hold their breath for.</p>
      <p class="mono muted hint">hover or tap an underline to preview the work</p>
    </div>
  </section>

  <section class="section" id="work">
    <div class="section-head"><h2>selected work</h2><span class="mono">02</span></div>
    <ol class="work">
      {work.map((w, i) => (
        <li>
          <a href={`/work/${w.id}`} class="card" data-sound="tap">
            <div class="card-top">
              <span class="mono muted">{String(i + 1).padStart(2, '0')}</span>
              <span class="badge" data-tone={statusLabel[w.data.status].tone}>{statusLabel[w.data.status].text}</span>
            </div>
            <h3 class="display" transition:name={`title-${w.id}`}>{w.data.title}</h3>
            <p>{w.data.summary}</p>
            {w.data.stats.length > 0 && (
              <dl class="stats">{w.data.stats.slice(0, 2).map((s) => <div><dt>{s.value}</dt><dd class="mono muted">{s.label}</dd></div>)}</dl>
            )}
            <span class="mono muted more">{w.data.role} · {w.data.years} <span aria-hidden="true">→</span></span>
          </a>
        </li>
      ))}
    </ol>
  </section>

  <section class="section" id="experience">
    <div class="section-head"><h2>experience</h2><span class="mono">03</span></div>
    <ExperienceToggle client:visible {...experience} />
  </section>

  <section class="section" id="pipeline">
    <div class="section-head"><h2>try the thing i build</h2><span class="mono">04</span></div>
    <p class="muted lead">A tiny CRM pipeline. Drag a deal to the next stage and close it.</p>
    <Pipeline client:visible />
  </section>

  <section class="section" id="activity">
    <div class="section-head"><h2>activity</h2><span class="mono">05</span></div>
    <GitHubGraph user="RIJUDEVx" />
    <ul class="stack">{stack.map((s) => <li class="mono">{s}</li>)}</ul>
  </section>

  <section class="section" id="contact">
    <div class="section-head"><h2>say hi</h2><span class="mono">06</span></div>
    <p class="lead-big display">Hiring a team lead, or need someone to own a backend end to end? I'd like to hear about it.</p>
    <div class="contact-row">
      <CopyEmail client:visible email={profile.email} big />
      <a class="pill" href="/resume.pdf" data-sound="tap"><Icon name="file" />Resume</a>
      <a class="pill" href={links[1].href} target="_blank" rel="noopener" data-sound="tap"><Icon name="linkedin" />LinkedIn</a>
    </div>
  </section>
</Base>

<style>
  .hero { padding: 48px var(--gutter) 40px; }
  .identity { display: flex; gap: 20px; align-items: center; }
  .avatar {
    flex: none; width: 96px; height: 96px; border-radius: 22px;
    border: 1px solid var(--rule-strong); background: var(--surface); box-shadow: var(--shadow);
    display: grid; place-items: center; color: var(--ink); font-size: 2.5rem;
    transform: rotate(-3deg);
  }
  h1 { font-size: clamp(2.5rem, 7vw, 3.5rem); }
  .tagline { margin: 6px 0 0; color: var(--muted); font-family: var(--font-mono); font-size: 0.875rem; }
  .facts { list-style: none; padding: 0; margin: 28px 0 0; display: grid; grid-template-columns: 1.25fr 1fr; gap: 10px 24px; font-family: var(--font-mono); font-size: 0.8125rem; color: var(--text); }
  .facts li { display: flex; align-items: center; gap: 10px; min-width: 0; }
  .facts :global(svg) { width: 15px; height: 15px; color: var(--muted); flex: none; }
  .avail { margin: 22px 0 0; display: flex; flex-wrap: wrap; align-items: center; gap: 10px; }
  .links { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 20px; }

  .prose p { margin: 0 0 16px; font-size: 1.0625rem; }
  .hint { font-size: 0.75rem; }

  .work { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .card { display: flex; flex-direction: column; gap: 10px; height: 100%; padding: 20px; border: 1px solid var(--rule); border-radius: var(--radius); background: var(--surface); text-decoration: none; transition: border-color 0.25s, transform 0.25s var(--ease), box-shadow 0.25s; }
  .card:hover { border-color: var(--rule-strong); transform: translateY(-3px); box-shadow: var(--shadow); }
  .card-top { display: flex; justify-content: space-between; align-items: center; }
  .card h3 { font-size: 1.75rem; }
  .card p { margin: 0; font-size: 0.9375rem; }
  .stats { display: flex; gap: 20px; margin: 4px 0 0; }
  .stats dt { font-family: var(--font-display); font-size: 1.5rem; color: var(--ink); line-height: 1.1; }
  .stats dd { margin: 0; font-size: 0.6875rem; }
  .more { margin-top: auto; font-size: 0.75rem; }

  .lead { margin: -8px 0 20px; }
  .stack { list-style: none; padding: 0; margin: 20px 0 0; display: flex; flex-wrap: wrap; gap: 6px; }
  .stack li { padding: 3px 9px; border: 1px solid var(--rule); border-radius: 6px; color: var(--muted); }

  .lead-big { font-size: clamp(1.6rem, 4vw, 2.2rem); color: var(--ink); margin: 0 0 24px; }
  .contact-row { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }

  @media (max-width: 640px) {
    .identity { flex-direction: column; align-items: flex-start; }
    .avatar { width: 80px; height: 80px; }
    .facts { grid-template-columns: 1fr; }
    .work { grid-template-columns: 1fr; }
  }
</style>
