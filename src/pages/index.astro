---
// Home. v1's single centred column (720px, every section on the same left edge)
// and v1's project cards, with the current hero, Experience, Activity, Ask,
// Stack, Playground and Contact. v1's tagline sits above the cut line, and the
// projects in the about text are underlined peeks with popup cards.
// Phones get iOS grouped lists and cards (see the 760px block at the bottom).
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Intro from '../components/Intro.svelte';
import Ascii from '../components/Ascii.astro';
import CutLine from '../components/CutLine.svelte';
import Clock from '../components/Clock.svelte';
import CopyEmail from '../components/CopyEmail.svelte';
import Questions from '../components/Questions.svelte';
import Pipeline from '../components/Pipeline.svelte';
import ExperienceToggle from '../components/ExperienceToggle.svelte';
import GitHubGraph from '../components/GitHubGraph.astro';
import StackKeys from '../components/bento/StackKeys.svelte';
import Brand from '../components/Brand.astro';
import Icon from '../components/Icon.astro';
import Peek from '../components/Peek.svelte';
import { profile, links, questions, experience, statusLabel, stackIcons, education } from '../data/site';

const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
const year = (y: string) => (y.match(/\d{4}/g) ?? []).join('–').replace(/^(\d{4})–\1$/, '$1') || '—';
const P = Object.fromEntries(work.map((w) => [w.id, {
  href: `/work/${w.id}`, title: w.data.title, area: w.data.area, years: year(w.data.years),
  status: statusLabel[w.data.status].text, tone: statusLabel[w.data.status].tone,
  summary: w.data.summary, stats: w.data.stats,
}]));
const social = links.filter((l) => l.brand);
const keys = stackIcons.map((s) => ({ label: s.label, icon: s.icon }));
---
<Base page="home" faq={questions}>
  <Intro slot="intro" client:load name={profile.name} />

  <section class="hero" id="top">
    <Ascii class="portrait" />
    <div class="copy">
      <p class="eyebrow"><span class="mono">@{profile.handle}</span><span class="sep">/</span><Icon name="pin" />{profile.city}<span class="sep dt">·</span><span class="when"><Icon name="clock" /><Clock client:load variant="hero" /></span></p>
      <h1>
        I'm Riju. I build backend platforms, Salesforce tooling and native apps,{' '}
        <span class="dim">and lead the team behind Selegic CRM.</span>
      </h1>
      <p class="sub">{profile.title} at <a href={profile.company.url} target="_blank" rel="noopener">Selegic India</a> · 4+ years · {work.length} projects</p>
      <div class="cta">
        <CopyEmail client:load email={profile.email} big />
        <a class="pill" href="/resume.pdf" data-sound="tap"><Icon name="file" />Resume</a>
        <span class="soc">{social.map((l) => <a class="icon" href={l.href} target="_blank" rel="noopener me" aria-label={l.label} data-sound="tap"><Brand name={l.brand!} mono size={16} /></a>)}</span>
      </div>
    </div>
  </section>

  <div class="sec about-wrap">
    <p class="tagline">{profile.tagline}</p>
    <CutLine client:visible label="Cut along the line to read more">
      <div class="prose" id="about">
        <p>I started at Selegic as an intern in January 2022, building a Chrome extension (<Peek client:visible {...P['switch-to-classic']}>Switch to Classic</Peek>) and Salesforce admin tools. Since then I've worked on native iOS apps (<Peek client:visible {...P['attenta-ios']}>Attenta</Peek>), built{' '}<Peek client:visible {...P['migrata']}>Migrata</Peek> for Salesforce AppExchange and the company's{' '}<Peek client:visible {...P['selegic-internal']}>time-tracking platform</Peek>, and designed{' '}<Peek client:visible {...P['selegic-crm']}>Selegic CRM</Peek>, which I now lead.</p>
        <p>The thread through all of it is the backend: data that stays correct, access control that holds, and releases nobody has to hold their breath for. I'm happiest owning a system end to end, from the schema to the deploy.</p>
        <p class="mono muted">{profile.workModes}</p>
      </div>
    </CutLine>
  </div>

  <section class="sec" id="work">
    <div class="label-row"><h2 class="label mono">Work</h2><span class="mono muted">{work.length} projects · 2022 – now</span></div>
    <ol class="work">
      {work.map((w) => (
        <li>
          <a href={`/work/${w.id}`} class="card" data-sound="tap" data-cursor="open">
            <div class="card-top">
              <h3>{w.data.title}</h3>
              <span class="badge" data-tone={statusLabel[w.data.status].tone}>{statusLabel[w.data.status].text}</span>
            </div>
            <p class="area mono">{w.data.area} · {year(w.data.years)}</p>
            <p class="cs">{w.data.summary}</p>
            {w.data.stats.length > 0 && (
              <dl class="stats">{w.data.stats.slice(0, 2).map((s) => <div><dt>{s.value}</dt><dd class="mono muted">{s.label}</dd></div>)}</dl>
            )}
            <ul class="tags">{w.data.stack.slice(0, 4).map((t) => <li class="mono">{t}</li>)}</ul>
          </a>
        </li>
      ))}
    </ol>
  </section>

  <section class="sec" id="experience">
    <h2 class="label mono">Experience</h2>
    <ExperienceToggle client:visible {...experience} />
  </section>

  <section class="sec" id="activity">
    <h2 class="label mono">Activity</h2>
    <GitHubGraph user="RIJUDEVx" />
  </section>

  <section class="sec" id="ask" aria-label="Ask">
    <p class="label mono">Ask</p>
    <Questions client:visible questions={questions} />
  </section>

  <section class="sec" id="stack">
    <h2 class="label mono">Stack</h2>
    <div class="keys"><StackKeys client:visible items={keys} /></div>
  </section>

  <section class="sec play" id="pipeline">
    <div class="label-row"><h2 class="label mono">Playground</h2><span class="mono muted">a toy version of what I build</span></div>
    <p class="play-lead">Drag a deal to the next stage and close it.</p>
    <Pipeline client:visible />
  </section>

  <section class="sec contact" id="contact">
    <h2 class="label mono">Contact</h2>
    <p class="statement">Building something that needs a backend owned end to end?{' '}<span class="dim">I'd like to hear about it.</span></p>
    <div class="cta">
      <CopyEmail client:visible email={profile.email} big />
      <a class="pill" href={links.find((l) => l.label === 'LinkedIn')!.href} target="_blank" rel="noopener" data-sound="tap"><Brand name="linkedin" mono size={14} />LinkedIn</a>
    </div>
  </section>

</Base>

<style>
  /* One column, one left edge: every section uses the page gutter and nothing more. */
  .sec { padding: 80px var(--gutter) 0; }
  .label { font-size: 0.6875rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); font-weight: 500; margin: 0 0 18px; }
  .label-row { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; margin-bottom: 18px; }
  .label-row .label { margin: 0; }
  .label-row .mono { font-size: 0.6875rem; }
  .dim { color: var(--muted); }
  .ink { color: var(--ink); }
  .small { font-size: 0.8125rem; }

  /* Hero */
  /* The hero keeps its original 1120px width; it breaks out of the 720px column, centred on it. */
  .hero { display: grid; grid-template-columns: auto 1fr; gap: 56px; align-items: center; padding: 112px 24px 32px; width: min(1120px, 100vw); position: relative; left: 50%; translate: -50% 0; }
  .portrait :global(pre) { font-size: 7px; }
  .eyebrow { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; color: var(--muted); font-size: 0.8125rem; margin: 0; }
  .eyebrow .mono { font-size: 0.75rem; }
  .eyebrow :global(svg) { width: 14px; height: 14px; }
  .sep { margin: 0 2px; opacity: 0.4; }
  .when { display: inline-flex; align-items: center; gap: 6px; }
  h1 { margin-top: 22px; font-size: clamp(2rem, 3.8vw, 3.1rem); font-weight: 600; letter-spacing: -0.04em; line-height: 1.08; max-width: 20ch; }
  .sub { margin: 18px 0 0; color: var(--text); font-size: 0.9375rem; }
  .sub a { color: var(--ink); text-decoration-color: var(--rule-strong); }
  .cta { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin-top: 26px; }
  .soc { display: contents; }
  .icon { width: 36px; height: 36px; border-radius: 50%; display: grid; place-items: center; color: var(--text); border: 1px solid var(--rule); transition: color 0.15s, border-color 0.15s; }
  .icon:hover { color: var(--ink); border-color: var(--rule-strong); }
  .about-wrap { padding-top: 8px; }
  .prose p { color: var(--text); font-size: 0.9375rem; line-height: 1.7; margin: 0 0 14px; }

  /* Work: v1's cards */
  .work { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .card { display: flex; flex-direction: column; gap: 8px; height: 100%; padding: 18px; border: 1px solid var(--rule); border-radius: var(--radius); background: var(--surface); text-decoration: none; transition: border-color 0.25s, transform 0.25s var(--ease), box-shadow 0.25s; }
  .card:hover { border-color: var(--rule-strong); transform: translateY(-2px); box-shadow: var(--shadow); }
  .card-top { display: flex; justify-content: space-between; align-items: flex-start; gap: 8px; }
  .card h3 { font-size: 1.0625rem; font-weight: 600; color: var(--ink); }
  .card p { margin: 0; }
  .card .area { font-size: 0.6875rem; color: var(--muted); margin-top: -4px; }
  .card .cs { font-size: 0.8125rem; line-height: 1.55; color: var(--text); }
  .stats { display: flex; gap: 20px; margin: 2px 0 0; }
  .stats dt { font-size: 1.125rem; font-weight: 600; color: var(--ink); letter-spacing: -0.02em; }
  .stats dd { margin: 0; font-size: 0.6875rem; }
  .tags { list-style: none; padding: 0; margin: auto 0 0; display: flex; flex-wrap: wrap; gap: 4px; }
  .tags li { font-size: 0.6875rem; padding: 1px 7px; border-radius: 6px; background: var(--rule); color: var(--text); }

  #ask :global(h2), #ask :global(h2 + p) { display: none; }

  .tagline { margin: 0 0 12px; font-size: 1rem; color: var(--ink); }
  .keys { max-width: 560px; }
  #stack :global(.top .k) { display: none; } /* the section label already says Stack */
  .play-lead { margin: -8px 0 18px; color: var(--muted); font-size: 0.875rem; }
  .contact { padding-bottom: 72px; display: grid; gap: 16px; }
  .contact .label { margin: 0; }
  .statement { margin: 0; font-size: 1.625rem; font-weight: 500; letter-spacing: -0.03em; line-height: 1.2; color: var(--ink); max-width: 26ch; }

  @media (max-width: 960px) {
    .hero { grid-template-columns: 1fr; gap: 28px; padding-top: 96px; }
    .portrait :global(pre) { font-size: 5.4px; }
  }
  @media (max-width: 640px) {
    .work { grid-template-columns: 1fr; }
  }

  /* Phones: iOS grouped lists and cards, system font and colours come from global.css. */
  @media (max-width: 760px) {
    .sec { padding-top: 40px; }
    .hero { grid-template-columns: 1fr; padding: 72px 16px 8px; justify-items: center; text-align: center; }
    .portrait :global(pre) { font-size: 4.6px; }
    .eyebrow { justify-content: center; }
    /* The clock fills in after load; give it its own line from the start so nothing below moves. */
    .when { flex-basis: 100%; justify-content: center; }
    .dt { display: none; }
    h1 { font-size: 1.875rem; font-weight: 700; letter-spacing: -0.03em; margin-inline: auto; }
    .sub { font-size: 0.9375rem; color: var(--muted); }
    .cta { justify-content: center; gap: 8px; }
    .soc { display: flex; flex-basis: 100%; justify-content: center; gap: 10px; margin-top: 4px; }
    .cta :global(.copy.pill) { background: var(--accent); color: #fff; border: 0; }
    .icon { width: 36px; height: 36px; border: 0; background: rgb(127 127 127 / 0.14); color: var(--ink); }
    .prose p { font-size: 1rem; }

    .label { font-size: 0.8125rem; letter-spacing: 0.02em; text-transform: none; color: var(--muted); padding-left: 16px; }
    .label-row .mono { display: none; }

    /* Projects: one grouped list, rows with a chevron, like Settings (as in v1). */
    .work { grid-template-columns: 1fr; gap: 0; border-radius: 20px; overflow: hidden; background: var(--surface); }
    .work li + li .card { border-top: 0.5px solid var(--rule-strong); }
    .card { border: 0; border-radius: 0; padding: 14px 40px 14px 16px; position: relative; gap: 6px; background: transparent; }
    .card::after { content: ''; position: absolute; right: 18px; top: 50%; width: 8px; height: 8px; border-right: 2px solid var(--rule-strong); border-top: 2px solid var(--rule-strong); transform: translateY(-50%) rotate(45deg); }
    .card:hover { transform: none; box-shadow: none; }
    .card:active { background: rgb(127 127 127 / 0.12); }
    .card .cs { font-size: 0.875rem; }
    .tags, .stats { display: none; }

    .contact { padding-bottom: 32px; }
    .contact .cta { display: grid; grid-template-columns: 1fr; }
    .contact .cta > :global(*) { justify-content: center; }
    .statement { font-size: 1.5rem; font-weight: 700; }
  }
</style>
