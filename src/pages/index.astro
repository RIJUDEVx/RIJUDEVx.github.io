---
// Home. One 720px column drawn like a ruled page: dotted rails down the sides,
// a dotted band between sections, serif section names. The quirks:
//  - the banner is Howrah Bridge in pixels, lit by the real time in Kolkata;
//  - the portrait is a 48px pixel picture that re-pixelates under the cursor;
//  - handwritten notes in the margins (wide screens only);
//  - the about text opens by cutting along a line, projects in it peek on hover;
//  - a toy CRM pipeline, a stack you can type on, and a backlog you can throw.
// Phones get iOS grouped lists and cards (see the 760px block at the bottom).
import '@fontsource/instrument-serif/400-italic.css';
import '@fontsource/caveat/latin-500.css';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Intro from '../components/Intro.svelte';
import Pixel from '../components/Pixel.astro';
import Skyline from '../components/Skyline.astro';
import Backlog from '../components/Backlog.svelte';
import CutLine from '../components/CutLine.svelte';
import Clock from '../components/Clock.svelte';
import CopyEmail from '../components/CopyEmail.svelte';
import Questions from '../components/Questions.svelte';
import Heist from '../components/Heist.svelte';
import ExperienceToggle from '../components/ExperienceToggle.svelte';
import GitHubGraph from '../components/GitHubGraph.astro';
import StackKeys from '../components/bento/StackKeys.svelte';
import Brand from '../components/Brand.astro';
import Icon from '../components/Icon.astro';
import Peek from '../components/Peek.svelte';
import { profile, links, questions, experience, statusLabel, stackIcons } from '../data/site';

const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
const year = (y: string) => (y.match(/\d{4}/g) ?? []).join('–').replace(/^(\d{4})–\1$/, '$1') || '—';
const P = Object.fromEntries(work.map((w) => [w.id, {
  href: `/work/${w.id}`, title: w.data.title, area: w.data.area, years: year(w.data.years),
  status: statusLabel[w.data.status].text, tone: statusLabel[w.data.status].tone,
  summary: w.data.summary, stats: w.data.stats,
}]));
const social = links.filter((l) => l.brand);
const keys = stackIcons.map((s) => ({ label: s.label, icon: s.icon }));
---
<Base page="home" faq={questions}>
  <Intro slot="intro" client:load name={profile.name} />

  <section class="hero" id="top">
    <div class="stage">
      <Skyline />
      <p class="note n-sky" aria-hidden="true">the sky follows<br />kolkata time.<br />click it to skip ahead.<svg viewBox="0 0 60 40" width="46" height="31" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M56 6C40 4 18 10 6 32"/><path d="M5 20l1 12 11-5"/></svg></p>
    </div>
    <div class="identity">
      <div class="avatar" data-cursor="hi"><Pixel class="portrait" /></div>
      <p class="note n-me" aria-hidden="true">me, at 48 pixels.<svg viewBox="0 0 60 40" width="46" height="31" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M56 6C40 4 18 10 6 32"/><path d="M5 20l1 12 11-5"/></svg></p>
      <p class="eyebrow"><span class="mono">@{profile.handle}</span><span class="sep">/</span><Icon name="pin" />{profile.city}<span class="sep dt">·</span><span class="when"><Icon name="clock" /><Clock client:load variant="hero" /></span></p>
    </div>
    <h1>
      <span class="ln">I'm Riju. I build backend platforms,</span>{' '}
      <span class="ln">Salesforce tooling and native apps,</span>{' '}
      <em class="ln">and lead the team behind Selegic CRM.</em>
    </h1>
    <p class="sub">{profile.title} at <a href={profile.company.url} target="_blank" rel="noopener">Selegic India</a> · 4+ years · {work.length} projects</p>
    <div class="cta">
      <CopyEmail client:load email={profile.email} big />
      <a class="pill" href="/resume.pdf" data-sound="tap"><Icon name="file" />Resume</a>
      <span class="soc">{social.map((l) => <a class="icon" href={l.href} target="_blank" rel="noopener me" aria-label={l.label} data-sound="tap"><Brand name={l.brand!} mono size={16} /></a>)}</span>
    </div>
  </section>

  <div class="band" aria-hidden="true"></div>

  <section class="sec" aria-labelledby="h-about">
    <header class="head"><h2 id="h-about">about</h2><span class="mono side">the short version first</span></header>
    <div class="body">
      <p class="tagline">{profile.tagline}</p>
      <CutLine client:visible label="Cut along the line to read more">
        <div class="prose" id="about">
        <p>I started at Selegic as an intern in January 2022, building a Chrome extension (<Peek client:visible {...P['switch-to-classic']}>Switch to Classic</Peek>) and Salesforce admin tools. Since then I've worked on native iOS apps (<Peek client:visible {...P['attenta-ios']}>Attenta</Peek>), built{' '}<Peek client:visible {...P['migrata']}>Migrata</Peek> for Salesforce AppExchange and the company's{' '}<Peek client:visible {...P['selegic-internal']}>time-tracking platform</Peek>, and designed{' '}<Peek client:visible {...P['selegic-crm']}>Selegic CRM</Peek>, which I now lead.</p>
        <p>The thread through all of it is the backend: data that stays correct, access control that holds, and releases nobody has to hold their breath for. I'm happiest owning a system end to end, from the schema to the deploy.</p>
        <p class="mono muted">{profile.workModes}</p>
        </div>
      </CutLine>
    </div>
  </section>

  <div class="band" aria-hidden="true"></div>

  <section class="sec" id="work" aria-labelledby="h-work">
    <header class="head"><h2 id="h-work">work</h2><span class="mono side">{work.length} projects · 2022 – now</span></header>
    <div class="body">
    <ol class="work">
      {work.map((w, i) => (
        <li class:list={{ lead: i === 0 }}>
          <a href={`/work/${w.id}`} class="card" data-sound="tap" data-cursor="open">
            <div class="card-top">
              <span class="area mono">{w.data.area}{/\d{4}/.test(w.data.years) && ` · ${year(w.data.years)}`}</span>
              <span class="badge" data-tone={statusLabel[w.data.status].tone} title={statusLabel[w.data.status].text}>{statusLabel[w.data.status].short ?? statusLabel[w.data.status].text}</span>
            </div>
            <h3>{w.data.title}</h3>
            <p class="cs">{w.data.summary}</p>
            {w.data.stats.length > 0 && (
              <dl class="stats">{w.data.stats.slice(0, i === 0 ? 3 : 2).map((s) => <div><dt>{s.value}</dt><dd class="mono muted">{s.label}</dd></div>)}</dl>
            )}
            <div class="card-foot">
              <ul class="tags">{w.data.stack.slice(0, i === 0 ? 6 : 4).map((t) => <li class="mono">{t}</li>)}</ul>
              <span class="open" aria-hidden="true">↗</span>
            </div>
          </a>
        </li>
      ))}
    </ol>
    </div>
  </section>

  <div class="band" aria-hidden="true"></div>

  <section class="sec" id="experience" aria-labelledby="h-exp">
    <header class="head"><h2 id="h-exp">experience</h2><span class="mono side">one company, many hats</span></header>
    <div class="body"><ExperienceToggle client:visible {...experience} /></div>
    <div class="rule" aria-hidden="true"></div>
    <div class="body" id="activity"><GitHubGraph user="RIJUDEVx" /></div>
  </section>

  <div class="band" aria-hidden="true"></div>

  <section class="sec" id="ask" aria-labelledby="h-ask">
    <header class="head"><h2 id="h-ask">before you hire me</h2><span class="mono side">go on, ask</span></header>
    <div class="body"><Questions client:visible questions={questions} /></div>
    <div class="rule" aria-hidden="true"></div>
    <div class="body" id="stack"><StackKeys client:visible items={keys} /></div>
  </section>

  <div class="band" aria-hidden="true"></div>

  <section class="sec" id="pipeline" aria-labelledby="h-play">
    <header class="head"><h2 id="h-play">try to break in</h2><span class="mono side">a toy copy of my access model</span></header>
    <div class="body">
      <p class="note n-play" aria-hidden="true">go on,<br />rob the place.<svg viewBox="0 0 60 40" width="46" height="31" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M56 6C40 4 18 10 6 32"/><path d="M5 20l1 12 11-5"/></svg></p>
      <Heist client:visible />
    </div>
  </section>

  <div class="band" aria-hidden="true"></div>

  <section class="sec" id="contact" aria-labelledby="h-hi">
    <header class="head"><h2 id="h-hi">say hi</h2><span class="mono side">{profile.workModes}</span></header>
    <div class="body contact">
      <p class="statement">Building something that needs a backend owned end to end?{' '}<em>I'd like to hear about it.</em></p>
      <div class="cta">
        <CopyEmail client:visible email={profile.email} big />
        <a class="pill" href={links.find((l) => l.label === 'LinkedIn')!.href} target="_blank" rel="noopener" data-sound="tap"><Brand name="linkedin" mono size={14} />LinkedIn</a>
      </div>
    </div>
  </section>

  <div class="band" aria-hidden="true"></div>

  <section class="sec" aria-labelledby="h-backlog">
    <header class="head"><h2 id="h-backlog">the backlog</h2><span class="mono side">everything I'll get to "later"</span></header>
    <div class="body pile-body"><Backlog client:visible /></div>
  </section>

  <!-- The yellow taxi from the banner, driving down the right rail as you scroll. Click it to go back up. -->
  <button class="taxi" type="button" data-taxi aria-label="Back to top" data-cursor="taxi!" data-sound="toggle">
    <svg viewBox="0 0 9 16" width="18" height="32" shape-rendering="crispEdges" aria-hidden="true">
      <rect x="1" y="1" width="7" height="14" fill="#f5c518" /><rect x="2" y="4" width="5" height="3" fill="#1b1b1b" /><rect x="2" y="10" width="5" height="2" fill="#1b1b1b" />
      <rect x="0" y="3" width="1" height="3" fill="#1b1b1b" /><rect x="8" y="3" width="1" height="3" fill="#1b1b1b" /><rect x="0" y="10" width="1" height="3" fill="#1b1b1b" /><rect x="8" y="10" width="1" height="3" fill="#1b1b1b" />
      <rect x="3" y="8" width="3" height="1" fill="#1b1b1b" /><rect x="2" y="15" width="1" height="1" fill="#ff5a4e" /><rect x="6" y="15" width="1" height="1" fill="#ff5a4e" /><rect x="2" y="0" width="1" height="1" fill="#fff6c9" /><rect x="6" y="0" width="1" height="1" fill="#fff6c9" />
    </svg>
  </button>
  <script>
    const taxi = document.querySelector<HTMLElement>('[data-taxi]');
    if (taxi) {
      let last = scrollY, raf = 0;
      const place = () => {
        raf = 0;
        const max = document.documentElement.scrollHeight - innerHeight;
        const p = max > 0 ? Math.min(1, scrollY / max) : 0;
        taxi.style.setProperty('--y', `${90 + p * (innerHeight - 200)}px`);
        if (scrollY !== last) taxi.classList.toggle('up', scrollY < last); // headlights lead the way
        taxi.classList.toggle('show', scrollY > 240);
        last = scrollY;
      };
      addEventListener('scroll', () => { if (!raf) raf = requestAnimationFrame(place); }, { passive: true });
      addEventListener('resize', place);
      taxi.addEventListener('click', () => document.querySelector<HTMLAnchorElement>('a[href="#top"]')?.click() ?? scrollTo({ top: 0, behavior: 'smooth' }));
      place();
    }
  </script>
</Base>

<style>
  /* The ruled page: dotted rails at the column edges, lines that run the full window width. */
  :global(.page) { border-inline: 1px dotted var(--rule-strong); }
  .band, .head, .rule, .stage { position: relative; }
  .band::before, .band::after, .head::after, .rule::before, .stage::after {
    content: ''; position: absolute; left: 50%; width: 100vw; translate: -50% 0; border-top: 1px dotted var(--rule-strong); pointer-events: none;
  }
  .band { height: 30px; background: radial-gradient(circle, var(--rule-strong) 0.9px, transparent 1.1px) 3px 3px / 8px 8px; }
  .band::before { top: 0; } .band::after, .head::after, .stage::after { bottom: 0; }
  .rule { height: 0; } .rule::before { top: 0; }

  .head { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; padding: 22px var(--gutter) 18px; }
  .head h2 { font-family: var(--font-serif); font-weight: 400; font-size: 2.125rem; line-height: 1; letter-spacing: -0.015em; color: var(--ink); }
  .side { font-size: 0.6875rem; color: var(--muted); text-align: right; }
  .body { position: relative; padding: 30px var(--gutter) 40px; }
  em { font-family: var(--font-serif); font-style: italic; font-weight: 400; letter-spacing: -0.01em; color: var(--text); font-size: 1.1em; }

  /* Handwritten margin notes, only where there is a margin to write in. */
  .note { display: none; }
  @media (min-width: 1240px) {
    .note { display: block; position: absolute; margin: 0; width: 190px; font-family: 'Caveat', cursive; font-weight: 500; font-size: 1.375rem; line-height: 1.1; color: var(--muted); pointer-events: none; }
    .note svg { display: block; margin-top: 6px; }
    .n-sky { left: calc(100% + 30px); top: 34px; rotate: -4deg; }
    .n-me { right: calc(100% + 26px); top: 6px; text-align: right; rotate: 3deg; }
    .n-me svg { margin-left: auto; scale: -1 1; }
    .n-play { right: calc(100% + 26px); top: 96px; text-align: right; rotate: -3deg; }
    .n-play svg { margin-left: auto; scale: -1 1; }
  }

  .taxi {
    position: fixed; z-index: 30; left: calc(50% + (var(--col) + 2 * var(--gutter)) / 2 - 9px); top: 0; translate: 0 var(--y, 90px);
    display: none; padding: 0; border: 0; background: none; cursor: pointer; line-height: 0; opacity: 0;
    transition: opacity 0.3s, translate 0.25s linear;
  }
  .taxi svg { rotate: 180deg; transition: rotate 0.35s var(--ease); } /* drawn nose-up; it drives down the page */
  .taxi:global(.up) svg { rotate: 0deg; }
  .taxi:global(.show) { opacity: 1; }
  @media (min-width: 900px) { .taxi { display: block; } }

  /* Hero: banner, portrait tile sitting on its edge, then the statement. */
  .hero { position: relative; padding: 60px 0 44px; }
  .identity { position: relative; display: flex; align-items: flex-end; gap: 20px; padding: 0 var(--gutter); margin-top: -52px; pointer-events: none; }
  .identity > * { pointer-events: auto; } /* the row overlaps the banner; only its contents should catch clicks */
  .avatar {
    flex: none; width: 112px; height: 124px; border-radius: 26px; overflow: hidden; display: grid; place-items: end center;
    background: var(--surface); border: 1px solid var(--rule-strong); box-shadow: 0 0 0 5px var(--paper), var(--shadow);
    rotate: -3deg; transition: rotate 0.4s var(--ease), scale 0.4s var(--ease);
  }
  .avatar:hover { rotate: 0deg; scale: 1.04; }
  .avatar :global(.portrait) { --pw: 100px; }
  .eyebrow { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; color: var(--muted); font-size: 0.8125rem; margin: 0 0 8px; }
  .eyebrow .mono { font-size: 0.75rem; }
  .eyebrow :global(svg) { width: 14px; height: 14px; }
  .sep { margin: 0 2px; opacity: 0.4; }
  .when { display: inline-flex; align-items: center; gap: 6px; }
  h1 { margin: 30px var(--gutter) 0; font-size: 2.625rem; font-weight: 600; letter-spacing: -0.04em; line-height: 1.08; }
  /* Fixed line breaks on wide screens, so the heading is three lines in any font and nothing jumps when the web fonts arrive. */
  @media (min-width: 761px) { .ln { display: block; white-space: nowrap; } h1 em { line-height: 0.98; } }
  .sub { margin: 18px var(--gutter) 0; color: var(--text); font-size: 0.9375rem; }
  .sub a { color: var(--ink); text-decoration-color: var(--rule-strong); }
  .cta { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin-top: 24px; }
  .hero .cta { padding: 0 var(--gutter); }
  .soc { display: contents; }
  .icon { width: 36px; height: 36px; border-radius: 50%; display: grid; place-items: center; color: var(--text); border: 1px solid var(--rule); transition: color 0.15s, border-color 0.15s; }
  .icon:hover { color: var(--ink); border-color: var(--rule-strong); }

  .tagline { margin: 0 0 12px; font-size: 1.0625rem; color: var(--ink); }
  .prose p { color: var(--text); font-size: 0.9375rem; line-height: 1.7; margin: 0 0 14px; }

  /* Work: v1's cards. The first project leads, full width, so the other six pair up. */
  .work { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .lead { grid-column: 1 / -1; }
  .card { display: flex; flex-direction: column; gap: 10px; height: 100%; padding: 20px; border: 1px solid var(--rule); border-radius: 16px; background: var(--surface); text-decoration: none; transition: border-color 0.25s, transform 0.25s var(--ease), box-shadow 0.25s; }
  .card:hover { border-color: var(--rule-strong); transform: translateY(-2px); box-shadow: var(--shadow); }
  .card-top { display: flex; justify-content: space-between; align-items: center; gap: 8px; min-height: 22px; }
  .card .area { font-size: 0.6875rem; color: var(--muted); }
  .card .badge { white-space: nowrap; font-size: 0.625rem; }
  .card h3 { font-size: 1.125rem; font-weight: 600; letter-spacing: -0.02em; color: var(--ink); }
  .lead h3 { font-size: 1.5rem; letter-spacing: -0.03em; }
  .card p { margin: 0; }
  .card .cs { font-size: 0.8125rem; line-height: 1.55; color: var(--text); max-width: 56ch; }
  .lead .cs { font-size: 0.9375rem; }
  .stats { display: flex; flex-wrap: wrap; gap: 6px 24px; margin: 4px 0 0; }
  .stats dt { font-size: 1.125rem; font-weight: 600; color: var(--ink); letter-spacing: -0.02em; }
  .lead .stats dt { font-size: 1.375rem; }
  .stats dd { margin: 0; font-size: 0.6875rem; }
  .card-foot { display: flex; justify-content: space-between; align-items: flex-end; gap: 12px; margin-top: auto; padding-top: 6px; }
  .tags { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 4px; }
  .tags li { font-size: 0.6875rem; padding: 1px 7px; border-radius: 6px; background: var(--rule); color: var(--text); }
  .open { flex: none; color: var(--muted); font-size: 0.875rem; line-height: 1; transition: transform 0.25s var(--ease), color 0.2s; }
  .card:hover .open { color: var(--ink); transform: translate(2px, -2px); }

  #ask :global(h2), #ask :global(h2 + p) { display: none; }
  #stack :global(.top .k) { letter-spacing: 0.12em; font-weight: 500; }

  .contact { display: grid; gap: 4px; }
  .statement { margin: 0; font-size: 1.75rem; font-weight: 600; letter-spacing: -0.035em; line-height: 1.15; color: var(--ink); max-width: 24ch; }
  .pile-body { padding-top: 18px; padding-bottom: 0; }

  @media (max-width: 640px) {
    .work { grid-template-columns: 1fr; }
  }

  /* Phones: iOS grouped lists and cards, system font and colours come from global.css. */
  @media (max-width: 760px) {
    :global(.page) { border-inline: 0; }
    .hero { padding: 0 0 28px; }
    .identity { flex-direction: column; align-items: flex-start; gap: 14px; margin-top: -44px; }
    .avatar { width: 96px; height: 106px; border-radius: 22px; }
    .avatar :global(.portrait) { --pw: 86px; }
    /* The clock fills in after load; give it its own line from the start so nothing below moves. */
    .when { flex-basis: 100%; }
    .dt { display: none; }
    h1 { font-size: 2rem; font-weight: 700; letter-spacing: -0.035em; margin-top: 18px; }
    .sub { color: var(--muted); }
    .hero .cta :global(.copy.pill) { background: var(--accent); color: #fff; border: 0; }
    .icon { border: 0; background: rgb(127 127 127 / 0.14); color: var(--ink); }
    .soc { display: flex; flex-basis: 100%; gap: 8px; }
    .prose p { font-size: 1rem; }
    .head { padding: 18px var(--gutter) 14px; }
    .head h2 { font-size: 1.875rem; }
    .side { display: none; }
    .body { padding: 22px var(--gutter) 30px; }
    .band { height: 22px; }

    /* Projects: one grouped list, rows with a chevron, like Settings (as in v1). */
    .work { grid-template-columns: 1fr; gap: 0; border-radius: 20px; overflow: hidden; background: var(--surface); }
    .work li + li .card { border-top: 0.5px solid var(--rule-strong); }
    .card { border: 0; border-radius: 0; padding: 14px 40px 14px 16px; position: relative; gap: 6px; background: transparent; }
    .card::after { content: ''; position: absolute; right: 18px; top: 50%; width: 8px; height: 8px; border-right: 2px solid var(--rule-strong); border-top: 2px solid var(--rule-strong); transform: translateY(-50%) rotate(45deg); }
    .card:hover { transform: none; box-shadow: none; }
    .card:active { background: rgb(127 127 127 / 0.12); }
    .card .cs, .lead .cs { font-size: 0.875rem; }
    .tags, .stats, .open { display: none; }
    .card h3, .lead h3 { font-size: 1.0625rem; letter-spacing: -0.01em; }

    .contact .cta { display: grid; grid-template-columns: 1fr; }
    .contact .cta > :global(*) { justify-content: center; }
    .contact .cta :global(.copy.pill) { width: 100%; text-align: center; }
    .statement { font-size: 1.5rem; font-weight: 700; }
  }
</style>
