---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const posts = await getCollection('writing');
  return posts.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
---
<Base title={entry.data.title} description={entry.data.summary} noindex={entry.data.draft}>
  <article class="post">
    <a class="back mono" href="/#glance">← home</a>
    {entry.data.draft && <span class="badge">Draft</span>}
    <h1>{entry.data.title}</h1>
    <p class="lede">{entry.data.summary}</p>
    <div class="body"><Content /></div>
  </article>
</Base>

<style>
  .post { padding: 104px var(--gutter) 64px; display: grid; gap: 14px; justify-items: start; }
  .back { color: var(--muted); text-decoration: none; }
  /* Phones have a back button in the navigation bar. */
  @media (max-width: 760px) { .back { display: none; } }
  h1 { font-size: clamp(1.75rem, 4vw, 2.5rem); font-weight: 600; letter-spacing: -0.035em; line-height: 1.12; }
  .lede { margin: 0; color: var(--text); font-size: 1.0625rem; }
  .body { width: 100%; padding-top: 12px; border-top: 1px solid var(--rule); color: var(--text); line-height: 1.75; }
</style>
