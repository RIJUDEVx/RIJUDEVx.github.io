---
// Variant B · Bento. A product-page grid (Linear / Vercel era): every tile is
// one fact you can check. The CRM gets the biggest tile because it's the story.
import { getCollection } from 'astro:content';
import VersionSwitch from '../../components/VersionSwitch.astro';
import Base from '../../layouts/Base.astro';
import Clock from '../../components/Clock.svelte';
import CopyEmail from '../../components/CopyEmail.svelte';
import Brand from '../../components/Brand.astro';
import GitHubGraph from '../../components/GitHubGraph.astro';
import Pipeline from '../../components/Pipeline.svelte';
import { profile, links, experience, statusLabel, stackIcons } from '../../data/site';

const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
const [crm, migrata, internal, docgen] = work;
const social = links.filter((l) => l.brand);
---
<Base title="Bento" noindex>
  <VersionSwitch />
  <section class="hero">
    <div class="who">
      <span class="tile-rd rd" aria-hidden="true">rd</span>
      <div>
        <p class="name">{profile.name}</p>
        <p class="mono muted">{profile.title} · Selegic India · Kolkata</p>
      </div>
    </div>
    <h1>I design multi-tenant platforms<br /><span class="dim">and lead the team that ships them.</span></h1>
    <div class="cta">
      <CopyEmail client:load email={profile.email} big />
      <a class="pill" href="/resume.pdf">Resume</a>
      {social.map((l) => <a class="icon" href={l.href} target="_blank" rel="noopener me" aria-label={l.label}><Brand name={l.brand!} mono size={17} /></a>)}
    </div>
  </section>

  <section class="grid" id="work" data-spotlight>
    <a class="t big" href={`/work/${crm.id}`} data-cursor="open">
      <div class="t-top"><span class="mono k">Flagship · {crm.data.years}</span><span class="badge" data-tone={statusLabel[crm.data.status].tone}>{statusLabel[crm.data.status].text}</span></div>
      <h2>{crm.data.title}</h2>
      <p>{crm.data.summary}</p>
      <dl class="nums">{crm.data.stats.map((s) => <div><dt>{s.value}</dt><dd>{s.label}</dd></div>)}</dl>
      <div class="arch" aria-hidden="true">
        <span>Workers</span><i></i><span>Hono API</span><i></i><span>Neon Postgres</span>
        <span class="sub">tenant pool</span><span class="sub">extension SDK</span><span class="sub">AI kernel</span>
      </div>
      <span class="go mono">Read the case study →</span>
    </a>

    <a class="t wide" href={`/work/${migrata.id}`} data-cursor="open">
      <div class="t-top"><span class="mono k">Salesforce</span><span class="badge" data-tone="ok">{statusLabel[migrata.data.status].text}</span></div>
      <h3>{migrata.data.title}</h3>
      <p>{migrata.data.summary}</p>
    </a>

    <div class="t now">
      <span class="mono k">Now</span>
      <p class="big-time"><Clock client:load variant="hero" /></p>
      <p class="muted small">Kolkata, India · IST</p>
      <p class="small">Leading the Selegic CRM team.</p>
    </div>

    <a class="t" href={`/work/${internal.id}`} data-cursor="open">
      <span class="mono k">Internal tools</span>
      <h3>{internal.data.title}</h3>
      <p class="small">{internal.data.summary}</p>
      <span class="badge" data-tone="ok">v1.5.0</span>
    </a>

    <div class="t xp">
      <span class="mono k">Experience</span>
      <h3>{experience.role}</h3>
      <p class="muted small">{experience.company} · {experience.dates}</p>
      <ul>{experience.long.slice(0, 3).map((l) => <li>{l}</li>)}</ul>
    </div>


    <div class="t gh">
      <GitHubGraph user="RIJUDEVx" />
    </div>

    <a class="t" href={`/work/${docgen.id}`} data-cursor="open">
      <span class="mono k">Service</span>
      <h3>{docgen.data.title}</h3>
      <p class="small">{docgen.data.summary}</p>
    </a>


    <div class="t stack">
      <span class="mono k">Stack I reach for</span>
      <div class="marquee" aria-label="Tech stack">
        <div class="track">
          {[...stackIcons, ...stackIcons].map((s) => <span class="chip"><Brand name={s.icon} size={16} />{s.label}</span>)}
        </div>
      </div>
    </div>
  </section>

  <section class="play" id="pipeline">
    <div class="play-head"><span class="mono k">Playground</span><h2>Try the thing I build</h2><p class="muted small">A tiny CRM pipeline. Drag a deal to the next stage and close it.</p></div>
    <Pipeline client:visible />
  </section>

  <script>
    // One spotlight that follows the pointer across the whole grid.
    function spot() {
      const g = document.querySelector<HTMLElement>('[data-spotlight]');
      if (!g || !matchMedia('(pointer: fine)').matches) return;
      g.addEventListener('pointermove', (e) => {
        for (const t of g.querySelectorAll<HTMLElement>('.t')) {
          const r = t.getBoundingClientRect();
          t.style.setProperty('--x', `${e.clientX - r.left}px`);
          t.style.setProperty('--y', `${e.clientY - r.top}px`);
        }
      });
    }
    spot();
    document.addEventListener('astro:page-load', spot);
  </script>
</Base>

<style>
  :global(.page) { max-width: 1120px !important; }
  .hero { padding: 104px 24px 40px; }
  .who { display: flex; align-items: center; gap: 12px; }
  .tile-rd { width: 44px; height: 44px; border-radius: 12px; display: grid; place-items: center; background: var(--surface); border: 1px solid var(--rule-strong); color: var(--ink); font-size: 1.6rem; padding-bottom: 3px; box-sizing: border-box; transform: rotate(-4deg); }
  .name { margin: 0; color: var(--ink); font-weight: 600; letter-spacing: -0.01em; }
  .who .mono { margin: 2px 0 0; }
  h1 { margin-top: 36px; font-size: clamp(2.25rem, 5.2vw, 3.75rem); font-weight: 600; letter-spacing: -0.045em; line-height: 1.02; max-width: 18ch; }
  .dim { color: var(--muted); }
  .cta { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin-top: 32px; }
  .icon { width: 36px; height: 36px; border-radius: 50%; display: grid; place-items: center; color: var(--text); border: 1px solid var(--rule); transition: color 0.15s, border-color 0.15s; }
  .icon:hover { color: var(--ink); border-color: var(--rule-strong); }

  .grid { display: grid; grid-auto-flow: dense; grid-template-columns: repeat(4, 1fr); grid-auto-rows: minmax(170px, auto); gap: 12px; padding: 0 24px; }
  .t {
    position: relative; overflow: hidden; display: flex; flex-direction: column; gap: 8px;
    padding: 22px; border-radius: 20px; background: var(--surface); border: 1px solid var(--rule);
    text-decoration: none; color: var(--text); transition: border-color 0.2s, transform 0.3s var(--ease);
  }
  .t::before { content: ''; position: absolute; inset: 0; pointer-events: none; opacity: 0; transition: opacity 0.3s; background: radial-gradient(360px circle at var(--x, 50%) var(--y, 50%), color-mix(in oklab, var(--accent) 10%, transparent), transparent 60%); }
  .grid:hover .t::before { opacity: 1; }
  a.t:hover { border-color: var(--rule-strong); transform: translateY(-2px); }
  .k { font-size: 0.6875rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--muted); }
  .t-top { display: flex; justify-content: space-between; align-items: center; gap: 8px; }
  .t h2 { font-size: 2rem; font-weight: 600; letter-spacing: -0.035em; margin-top: 8px; }
  .t h3 { font-size: 1.125rem; font-weight: 600; letter-spacing: -0.015em; }
  .t p { margin: 0; line-height: 1.55; }
  .small { font-size: 0.875rem; }

  .big { grid-column: span 2; grid-row: span 2; }
  .wide, .xp { grid-column: span 2; }
  .stack { grid-column: span 3; }
  .gh { grid-column: span 2; grid-row: span 1; }
  .nums { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px 24px; margin: 18px 0 0; }
  .nums dt { font-size: 1.75rem; font-weight: 600; color: var(--ink); letter-spacing: -0.03em; }
  .nums dd { margin: 0; font-size: 0.75rem; color: var(--muted); }
  .arch { margin-top: auto; padding-top: 22px; display: grid; grid-template-columns: auto 1fr auto 1fr auto; align-items: center; gap: 8px; font-family: var(--font-mono); font-size: 0.6875rem; color: var(--text); }
  .arch > span:not(.sub) { padding: 5px 9px; border: 1px solid var(--rule-strong); border-radius: 8px; background: var(--paper); }
  .arch i { height: 1px; background: linear-gradient(90deg, var(--rule-strong) 50%, transparent 50%) 0 0 / 8px 1px; animation: flow 1.2s linear infinite; }
  @keyframes flow { to { background-position: 8px 0; } }
  .arch .sub { grid-row: 2; color: var(--muted); text-align: center; }
  .arch .sub:nth-of-type(4) { grid-column: 1; } .arch .sub:nth-of-type(5) { grid-column: 3; } .arch .sub:nth-of-type(6) { grid-column: 5; }
  .go { color: var(--accent); font-size: 0.75rem; margin-top: 14px; }

  .now .big-time { font-size: 1.125rem; color: var(--ink); margin-top: 6px; }
  .xp ul { margin: 6px 0 0; padding-left: 16px; display: grid; gap: 6px; font-size: 0.8125rem; line-height: 1.5; }
  .gh :global(svg) { max-width: 100%; }
  .marquee { overflow: hidden; margin: auto -22px 0; mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent); }
  .track { display: flex; gap: 8px; width: max-content; animation: slide 36s linear infinite; padding: 8px 0; }
  .stack:hover .track { animation-play-state: paused; }
  @keyframes slide { to { transform: translateX(-50%); } }
  .chip { display: inline-flex; align-items: center; gap: 8px; padding: 7px 12px; border-radius: 999px; border: 1px solid var(--rule); background: var(--paper); font-size: 0.8125rem; color: var(--ink); white-space: nowrap; }

  .play { padding: 96px 24px 64px; }
  .play-head { margin-bottom: 20px; }
  .play-head h2 { font-size: 1.75rem; font-weight: 600; letter-spacing: -0.03em; margin: 6px 0 4px; }

  @media (max-width: 900px) {
    .grid { grid-template-columns: repeat(2, 1fr); }
    .big { grid-column: span 2; grid-row: auto; }
    .stack { grid-column: span 2; }
  }
  @media (max-width: 600px) {
    .hero { padding: 80px 16px 28px; }
    .grid { grid-template-columns: 1fr; padding: 0 16px; }
    .big, .wide, .xp, .stack, .gh { grid-column: auto; }
    .play { padding: 64px 16px; }
  }
</style>
