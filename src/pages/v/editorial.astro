---
// Variant A · Editorial. Two columns: a sticky identity column on the left,
// the work on the right. Restraint over tricks; proof (numbers, ownership) up front.
import { getCollection } from 'astro:content';
import VersionSwitch from '../../components/VersionSwitch.astro';
import Base from '../../layouts/Base.astro';
import Clock from '../../components/Clock.svelte';
import CopyEmail from '../../components/CopyEmail.svelte';
import Brand from '../../components/Brand.astro';
import GitHubGraph from '../../components/GitHubGraph.astro';
import { profile, links, experience, statusLabel, stackIcons, education } from '../../data/site';

const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
const social = links.filter((l) => l.brand);
const sections = [
  { id: 'about', label: 'About' },
  { id: 'work', label: 'Work' },
  { id: 'experience', label: 'Experience' },
  { id: 'activity', label: 'Activity' },
];
---
<Base title="Editorial" noindex>
  <VersionSwitch />
  <div class="ed">
    <aside class="side">
      <div class="side-in">
        <span class="mono eyebrow">{profile.handle}</span>
        <h1>{profile.name}</h1>
        <p class="role">{profile.title}, <a href={profile.company.url} target="_blank" rel="noopener">Selegic India</a></p>
        <p class="pitch">I design multi-tenant platforms and lead the team that ships them.</p>

        <nav class="toc" aria-label="On this page">
          {sections.map((s, i) => (
            <a href={`#${s.id}`} data-toc={s.id}><span class="mono n">0{i + 1}</span><span class="bar" aria-hidden="true"></span>{s.label}</a>
          ))}
        </nav>

        <div class="side-foot">
          <div class="social">
            {social.map((l) => <a href={l.href} target="_blank" rel="noopener me" aria-label={l.label}><Brand name={l.brand!} mono size={18} /></a>)}
            <a class="cv mono" href="/resume.pdf">resume ↗</a>
          </div>
          <p class="mono muted local">Kolkata · <Clock client:load variant="hero" /></p>
        </div>
      </div>
    </aside>

    <div class="main">
      <section id="about" class="block">
        <p class="lead">
          For the last two years I've owned <strong>Selegic CRM</strong> end to end. I designed it, shipped
          v1.0.0 on my own in five months, then rebuilt it on Cloudflare Workers and Postgres with a team I now lead.
        </p>
        <p>
          The work I'm proudest of is the unglamorous kind: tenant isolation that holds, a permission model
          the AI agents can't talk their way around, and a release process where every change ships with a preview
          and passes end-to-end tests first. 236 changes have gone out that way since July.
        </p>
        <p>
          Before the CRM I built <strong>Migrata</strong>, now on Salesforce AppExchange, the time-tracking platform
          Selegic runs on, and native iOS apps.
        </p>
      </section>

      <section id="work" class="block">
        <h2 class="mono label">Selected work</h2>
        <ol class="rows">
          {work.map((w) => (
            <li>
              <a class="row" href={`/work/${w.id}`} data-cursor="open">
                <span class="mono yr">{/\d/.test(w.data.years) ? w.data.years : ""}</span>
                <div class="body">
                  <h3>{w.data.title} <span class="arrow" aria-hidden="true">↗</span></h3>
                  <p>{w.data.summary}</p>
                  {w.data.stats.length > 0 && (
                    <dl class="stats">{w.data.stats.slice(0, 3).map((s) => <div><dt>{s.value}</dt><dd>{s.label}</dd></div>)}</dl>
                  )}
                  <ul class="tags">
                    <li class="st" data-tone={statusLabel[w.data.status].tone}>{statusLabel[w.data.status].text}</li>
                    {w.data.stack.slice(0, 4).map((t) => <li>{t}</li>)}
                  </ul>
                </div>
              </a>
            </li>
          ))}
        </ol>
      </section>

      <section id="experience" class="block">
        <h2 class="mono label">Experience</h2>
        <div class="xp">
          <div class="xp-head">
            <div><h3>{experience.role}</h3><p class="muted">{experience.company} · Kolkata</p></div>
            <span class="mono muted">{experience.dates}</span>
          </div>
          <ul>{experience.long.map((l) => <li>{l}</li>)}</ul>
        </div>
        <div class="xp minor">
          <div class="xp-head">
            <div><h3>B.Tech, Computer Science</h3><p class="muted">{education.school}</p></div>
            <span class="mono muted">{education.years}</span>
          </div>
        </div>
      </section>

      <section id="activity" class="block">
        <h2 class="mono label">Activity</h2>
        <GitHubGraph user="RIJUDEVx" />
        <p class="stack mono">
          {stackIcons.map((s, i) => <span>{s.label}{i < stackIcons.length - 1 ? ' · ' : ''}</span>)}
        </p>
      </section>

      <section class="block contact">
        <p class="lead">If you're building something that needs a backend owned end to end, I'd like to hear about it.</p>
        <CopyEmail client:visible email={profile.email} big />
      </section>
    </div>
  </div>

  <script>
    // Highlight the TOC entry for the section in view.
    function toc() {
      const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-toc]')];
      if (!links.length) return;
      const io = new IntersectionObserver((es) => {
        for (const e of es) if (e.isIntersecting) links.forEach((l) => l.classList.toggle('on', l.dataset.toc === e.target.id));
      }, { rootMargin: '-40% 0px -55% 0px' });
      links.forEach((l) => { const t = document.getElementById(l.dataset.toc!); if (t) io.observe(t); });
    }
    toc();
    document.addEventListener('astro:page-load', toc);
  </script>
</Base>

<style>
  /* Break out of the 720px site column for this layout. */
  :global(.page) { max-width: 1120px !important; }
  .ed { display: grid; grid-template-columns: 340px 1fr; gap: 64px; padding: 0 24px; }
  .side-in { position: sticky; top: 0; height: 100vh; display: flex; flex-direction: column; padding: 96px 0 48px; box-sizing: border-box; }
  .eyebrow { color: var(--muted); }
  h1 { font-size: 2.5rem; font-weight: 600; letter-spacing: -0.035em; line-height: 1.05; margin-top: 10px; }
  .role { margin: 10px 0 0; color: var(--ink); font-size: 1.0625rem; }
  .role a { color: inherit; text-decoration-color: var(--rule-strong); }
  .pitch { margin: 14px 0 0; color: var(--muted); max-width: 28ch; line-height: 1.55; }
  .toc { display: grid; gap: 2px; margin-top: 56px; }
  .toc a { display: flex; align-items: center; gap: 12px; padding: 6px 0; color: var(--muted); text-decoration: none; font-size: 0.8125rem; text-transform: uppercase; letter-spacing: 0.08em; font-weight: 500; transition: color 0.15s; }
  .toc .n { font-size: 0.6875rem; letter-spacing: 0; opacity: 0.6; }
  .toc .bar { width: 28px; height: 1px; background: currentColor; transition: width 0.25s var(--ease); }
  .toc a:hover, .toc a.on { color: var(--ink); }
  .toc a:hover .bar, .toc a.on .bar { width: 56px; }
  .side-foot { margin-top: auto; display: grid; gap: 14px; }
  .social { display: flex; align-items: center; gap: 18px; }
  .social a { color: var(--muted); transition: color 0.15s; }
  .social a:hover { color: var(--ink); }
  .cv { margin-left: auto; text-decoration: none; }
  .local { margin: 0; font-size: 0.75rem; }

  .main { padding: 96px 0 64px; min-width: 0; }
  .block { margin-bottom: 96px; }
  .label { font-size: 0.6875rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); font-weight: 500; margin-bottom: 20px; }
  .lead { font-size: 1.375rem; line-height: 1.5; color: var(--ink); letter-spacing: -0.015em; margin: 0 0 20px; }
  .block p { color: var(--text); line-height: 1.75; }
  strong { color: var(--ink); font-weight: 600; }

  .rows { list-style: none; padding: 0; margin: 0 -20px; display: grid; gap: 4px; }
  .row { display: grid; grid-template-columns: 132px 1fr; gap: 20px; padding: 20px; border-radius: 14px; text-decoration: none; transition: background 0.2s; }
  .row:hover { background: color-mix(in oklab, var(--surface) 70%, transparent); box-shadow: inset 0 0 0 1px var(--rule); }
  .rows:hover .row:not(:hover) { opacity: 0.55; }
  .row { transition: background 0.2s, opacity 0.2s; }
  .yr { color: var(--muted); padding-top: 4px; font-size: 0.6875rem; }
  h3 { font-size: 1.0625rem; font-weight: 600; letter-spacing: -0.01em; }
  .arrow { display: inline-block; color: var(--muted); transition: transform 0.2s var(--ease); }
  .row:hover .arrow { transform: translate(2px, -2px); color: var(--accent); }
  .body p { margin: 6px 0 0; font-size: 0.9375rem; line-height: 1.6; }
  .stats { display: flex; gap: 28px; margin: 14px 0 0; }
  .stats dt { font-size: 1.25rem; font-weight: 600; color: var(--ink); letter-spacing: -0.02em; }
  .stats dd { margin: 0; font-size: 0.75rem; color: var(--muted); }
  .tags { list-style: none; padding: 0; margin: 14px 0 0; display: flex; flex-wrap: wrap; gap: 6px; }
  .tags li { font-size: 0.75rem; padding: 3px 10px; border-radius: 999px; background: color-mix(in oklab, var(--accent) 10%, transparent); color: var(--accent); }
  .tags .st { background: transparent; box-shadow: inset 0 0 0 1px var(--rule-strong); color: var(--text); }
  .tags .st[data-tone='ok'] { color: var(--ok); }

  .xp + .xp { margin-top: 28px; }
  .xp-head { display: flex; justify-content: space-between; gap: 16px; align-items: baseline; }
  .xp-head p { margin: 2px 0 0; font-size: 0.875rem; }
  .xp ul { margin: 14px 0 0; padding-left: 18px; display: grid; gap: 8px; color: var(--text); line-height: 1.65; font-size: 0.9375rem; }
  .xp ul li::marker { color: var(--rule-strong); }
  .minor h3 { font-size: 0.9375rem; }
  .stack { margin-top: 20px; color: var(--muted); line-height: 1.9; font-size: 0.75rem; }
  .contact { display: grid; gap: 8px; justify-items: start; }

  @media (max-width: 960px) {
    .ed { grid-template-columns: 1fr; gap: 0; padding: 0 16px; }
    .side-in { position: static; height: auto; padding: 72px 0 24px; }
    .toc { display: none; }
    .main { padding-top: 32px; }
    .rows { margin: 0; }
    .row { grid-template-columns: 1fr; gap: 6px; padding: 16px 0; }
    .rows:hover .row:not(:hover) { opacity: 1; }
  }
</style>
