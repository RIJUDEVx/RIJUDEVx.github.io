---
// Variant C · Index. Swiss, type-led, almost no chrome. A statement paragraph,
// then the work as a big numbered index; hovering a row floats its preview card
// next to the cursor. Feels like a senior designer-engineer's site (rauno, emil).
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Clock from '../../components/Clock.svelte';
import CopyEmail from '../../components/CopyEmail.svelte';
import GitHubGraph from '../../components/GitHubGraph.astro';
import { profile, links, experience, statusLabel, education } from '../../data/site';

const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
---
<Base title="Index" noindex>
  <section class="intro">
    <div class="meta mono">
      <span>{profile.handle}</span>
      <span><Clock client:load variant="footer" /></span>
    </div>
    <p class="statement">
      <span class="ink">Riju Dev Purkayastha</span> is a senior software engineer at{' '}
      <a href={profile.company.url} target="_blank" rel="noopener">Selegic India</a>. He designed{' '}
      <a href="/work/selegic-crm">Selegic CRM</a>{' '}and took it to its first release alone in five months;
      today he leads the team building it on Cloudflare Workers and Postgres.{' '}
      <span class="dim">Before that: <a href="/work/migrata">Migrata</a> on AppExchange, the company's{' '}
      <a href="/work/selegic-internal">time-tracking platform</a>, and native iOS apps.</span>
    </p>
    <div class="links mono">
      {links.map((l) => <a href={l.href} target={l.href.startsWith('http') ? '_blank' : undefined} rel="noopener me">{l.label} ↗</a>)}
    </div>
  </section>

  <section class="index" id="work" data-index>
    <div class="ih mono"><span>Index</span><span>Status</span><span>Year</span></div>
    <ol>
      {work.map((w, i) => (
        <li>
          <a href={`/work/${w.id}`} data-preview={`/og/work/${w.id}.png`} data-cursor="open">
            <span class="mono n">{String(i + 1).padStart(2, '0')}</span>
            <span class="ttl">{w.data.title}</span>
            <span class="mono st" data-tone={statusLabel[w.data.status].tone}>{statusLabel[w.data.status].text}</span>
            <span class="mono yr">{(w.data.years.match(/\d{4}/) ?? ['—'])[0]}</span>
            <span class="sum">{w.data.summary}</span>
          </a>
        </li>
      ))}
    </ol>
    <img class="float" alt="" aria-hidden="true" width="1200" height="630" />
  </section>

  <section class="two" id="experience">
    <h2 class="mono">Experience</h2>
    <div>
      <div class="xp-row"><span class="ink">{experience.role}, {experience.company}</span><span class="mono dim">{experience.dates}</span></div>
      <p class="dim">{experience.tldr}</p>
      <ul>{experience.long.slice(0, 4).map((l) => <li>{l}</li>)}</ul>
      <div class="xp-row edu"><span class="ink">B.Tech, Computer Science · MAKAUT</span><span class="mono dim">{education.years}</span></div>
    </div>
  </section>

  <section class="two" id="activity">
    <h2 class="mono">Activity</h2>
    <div><GitHubGraph user="RIJUDEVx" /></div>
  </section>

  <section class="two" id="contact">
    <h2 class="mono">Contact</h2>
    <div class="contact">
      <p class="ink big">Building something that needs a backend owned end to end?</p>
      <CopyEmail client:visible email={profile.email} big />
    </div>
  </section>

  <script>
    // Floating preview that trails the cursor over the index (fine pointers only).
    function index() {
      const root = document.querySelector<HTMLElement>('[data-index]');
      const img = root?.querySelector<HTMLImageElement>('.float');
      if (!root || !img || !matchMedia('(pointer: fine)').matches) return;
      let x = 0, y = 0, tx = 0, ty = 0, raf = 0;
      const loop = () => { x += (tx - x) * 0.18; y += (ty - y) * 0.18; img.style.transform = `translate3d(${x}px, ${y}px, 0)`; raf = requestAnimationFrame(loop); };
      root.querySelectorAll<HTMLAnchorElement>('a[data-preview]').forEach((a) => {
        a.addEventListener('pointerenter', () => { img.src = a.dataset.preview!; img.classList.add('on'); });
        a.addEventListener('pointerleave', () => img.classList.remove('on'));
      });
      root.addEventListener('pointermove', (e) => { tx = e.clientX + 24; ty = e.clientY - 90; if (!raf) loop(); });
    }
    index();
    document.addEventListener('astro:page-load', index);
  </script>
</Base>

<style>
  :global(.page) { max-width: 1040px !important; }
  .intro { padding: 120px 24px 72px; }
  .meta { display: flex; justify-content: space-between; color: var(--muted); font-size: 0.75rem; }
  .statement { margin: 40px 0 0; font-size: clamp(1.6rem, 3.4vw, 2.5rem); line-height: 1.25; letter-spacing: -0.03em; font-weight: 500; color: var(--text); max-width: 30ch; }
  .statement a { color: var(--ink); text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 6px; text-decoration-color: var(--rule-strong); transition: text-decoration-color 0.2s; }
  .statement a:hover { text-decoration-color: var(--accent); }
  .ink { color: var(--ink); }
  .dim { color: var(--muted); }
  .links { display: flex; flex-wrap: wrap; gap: 20px; margin-top: 36px; font-size: 0.75rem; }
  .links a { color: var(--muted); text-decoration: none; transition: color 0.15s; }
  .links a:hover { color: var(--ink); }

  .index { position: relative; padding: 0 24px; }
  .ih { display: grid; grid-template-columns: 1fr 180px 80px; padding: 0 0 12px 56px; color: var(--muted); font-size: 0.6875rem; text-transform: uppercase; letter-spacing: 0.1em; border-bottom: 1px solid var(--rule); }
  ol { list-style: none; margin: 0; padding: 0; }
  li a { display: grid; grid-template-columns: 56px 1fr 180px 80px; align-items: baseline; row-gap: 4px; padding: 22px 0; border-bottom: 1px solid var(--rule); text-decoration: none; color: var(--ink); transition: color 0.2s, padding 0.3s var(--ease); }
  .n { color: var(--muted); font-size: 0.75rem; }
  .ttl { font-size: clamp(1.6rem, 3.6vw, 2.6rem); font-weight: 500; letter-spacing: -0.04em; line-height: 1.05; }
  .st { font-size: 0.75rem; color: var(--muted); }
  .st[data-tone='ok'] { color: var(--ok); } .st[data-tone='pilot'] { color: var(--accent); }
  .yr { font-size: 0.75rem; color: var(--muted); }
  .sum { grid-column: 2 / 4; color: var(--muted); font-size: 0.875rem; max-width: 56ch; max-height: 0; overflow: hidden; opacity: 0; transition: max-height 0.35s var(--ease), opacity 0.25s; }
  ol:hover li a { color: var(--muted); }
  ol li a:hover { color: var(--ink); padding-left: 8px; }
  ol li a:hover .sum, ol li a:focus-visible .sum { max-height: 4em; opacity: 1; }
  .float { position: fixed; left: 0; top: 0; width: 300px; height: auto; border-radius: 12px; pointer-events: none; z-index: 40; opacity: 0; scale: 0.92; transition: opacity 0.2s, scale 0.3s var(--ease); box-shadow: 0 24px 60px -20px rgb(0 0 0 / 0.6); }
  .float:global(.on) { opacity: 1; scale: 1; }

  .two { display: grid; grid-template-columns: 200px 1fr; gap: 24px; padding: 72px 24px 0; }
  .two h2 { font-size: 0.6875rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--muted); font-weight: 500; padding-top: 4px; }
  .xp-row { display: flex; justify-content: space-between; gap: 16px; align-items: baseline; }
  .two p { line-height: 1.7; }
  .two ul { padding-left: 18px; color: var(--text); line-height: 1.7; display: grid; gap: 6px; font-size: 0.9375rem; }
  .edu { margin-top: 28px; padding-top: 20px; border-top: 1px solid var(--rule); }
  .contact { display: grid; gap: 14px; justify-items: start; padding-bottom: 56px; }
  .big { font-size: 1.5rem; letter-spacing: -0.025em; margin: 0; }

  @media (max-width: 760px) {
    .intro { padding: 88px 16px 48px; }
    .index { padding: 0 16px; }
    .ih { display: none; }
    li a { grid-template-columns: 36px 1fr auto; }
    .yr { display: none; }
    .sum { grid-column: 2 / 4; max-height: none; opacity: 1; }
    .two { grid-template-columns: 1fr; padding: 48px 16px 0; gap: 12px; }
  }
</style>
