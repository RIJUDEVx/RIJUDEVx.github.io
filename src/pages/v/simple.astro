---
// Variant · Simple. Plain, clean, a little quirky: the page reads like a short note.
// One switch at the top, "tl;dr | the long version", changes every section at once.
// Every project mentioned in the text is an underlined peek with a popup card.
import { getCollection } from 'astro:content';
import VersionSwitch from '../../components/VersionSwitch.astro';
import Base from '../../layouts/Base.astro';
import Ascii from '../../components/Ascii.astro';
import Depth from '../../components/Depth.svelte';
import Peek from '../../components/Peek.svelte';
import Clock from '../../components/Clock.svelte';
import CopyEmail from '../../components/CopyEmail.svelte';
import Pipeline from '../../components/Pipeline.svelte';
import Brand from '../../components/Brand.astro';
import { getContributions, summarise } from '../../lib/github';
import { profile, links, statusLabel, stackIcons, education } from '../../data/site';

const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
const writing = await getCollection('writing');
const year = (y: string) => (y.match(/\d{4}/g) ?? []).join('–').replace(/^(\d{4})–\1$/, '$1') || 'Selegic';
const P = Object.fromEntries(work.map((w) => [w.id, {
  href: `/work/${w.id}`, title: w.data.title, area: w.data.area, years: year(w.data.years),
  status: statusLabel[w.data.status].text, tone: statusLabel[w.data.status].tone,
  summary: w.data.summary, stats: w.data.stats,
}]));

const contrib = await getContributions('RIJUDEVx');
const sum = contrib ? summarise(contrib) : null;
// Inline sparkline of weekly contributions, drawn at build time.
const spark = (() => {
  if (!sum) return '';
  const w = sum.weeks.map((x) => x.count), max = Math.max(1, ...w), W = 120, H = 18;
  const pts = w.map((v, i) => `${((i / (w.length - 1)) * W).toFixed(1)},${(H - (v / max) * (H - 2) - 1).toFixed(1)}`).join(' ');
  return `<svg viewBox="0 0 ${W} ${H}" width="${W}" height="${H}" aria-hidden="true" class="spark"><polyline points="${pts}" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" stroke-linecap="round"/></svg>`;
})();
const social = links.filter((l) => l.brand);
const milestones = [
  { when: 'Jan 2022', what: 'Joined Selegic as an intern.', detail: 'Switch to Classic, Remote Tooling.' },
  { when: 'Oct 2022', what: 'Native iOS.', detail: 'Attenta Yoga, then top contributor on AttentaFit.' },
  { when: 'Aug 2024', what: 'Started Selegic CRM, alone.', detail: 'Empty repo to v1.0.0 by Jan 2025.' },
  { when: 'Apr 2025', what: 'Selegic Internal.', detail: "The company's time-tracking platform." },
  { when: 'Mar 2026', what: 'Extension platform.', detail: 'Public SDK and CLI for outside developers.' },
  { when: 'Now', what: 'Leading the CRM team.', detail: '236 changes shipped since Jul 2026.' },
];
---
<Base title="Simple" noindex>
  <VersionSwitch />
  <article class="note">
    <header class="head">
      <Ascii class="face" />
      <div>
        <p class="hello mono">{profile.handle} · <Clock client:load variant="footer" /></p>
        <h1>Riju Dev Purkayastha</h1>
        <div class="links">
          {social.map((l) => <a href={l.href} target="_blank" rel="noopener me" aria-label={l.label}><Brand name={l.brand!} mono size={16} /></a>)}
          <a class="mono cv" href="/resume.pdf">resume ↗</a>
        </div>
      </div>
    </header>

    <div class="switch"><Depth client:load /><span class="mono hint short">the short one. there's more →</span><span class="mono hint long">everything. it's still short.</span></div>

    <section id="about">
      <h2 class="mono">hi</h2>
      <p class="short">I'm Riju, a backend-leaning full-stack engineer in Kolkata. I build platforms and lead the team behind <Peek client:visible {...P['selegic-crm']}>Selegic CRM</Peek>.</p>
      <div class="long">
        <p>I'm Riju, a backend-leaning full-stack engineer in Kolkata. I've been at Selegic since January 2022, when I joined as an intern, and I now lead the team behind <Peek client:visible {...P['selegic-crm']}>Selegic CRM</Peek>, a multi-tenant platform I designed and took to its first release on my own.</p>
        <p>The thread through everything is the backend: data that stays correct, access control that holds, and releases nobody has to hold their breath for. I'm happiest owning a system end to end, from the schema to the deploy.</p>
        <p class="muted">{profile.workModes}.</p>
      </div>
    </section>

    <section id="work">
      <h2 class="mono">work</h2>
      <p class="short">
        Lately: <Peek client:visible {...P['selegic-crm']}>Selegic CRM</Peek>. Before that, <Peek client:visible {...P['migrata']}>Migrata</Peek> on AppExchange,
        the company's <Peek client:visible {...P['selegic-internal']}>time-tracking platform</Peek>, <Peek client:visible {...P['doc-gen']}>Doc Gen</Peek>,
        two iOS apps (<Peek client:visible {...P['attenta-ios']}>AttentaFit &amp; Attenta Yoga</Peek>) and Salesforce tools
        (<Peek client:visible {...P['switch-to-classic']}>Switch to Classic</Peek>, <Peek client:visible {...P['remote-tooling']}>Remote Tooling</Peek>).
      </p>
      <ol class="long projects">
        {work.map((w) => (
          <li>
            <a href={`/work/${w.id}`}>
              <div class="p-head"><span class="p-t">{w.data.title}</span><span class="mono p-m">{w.data.area} · {year(w.data.years)}</span></div>
              <p>{w.data.summary}</p>
              {w.data.stats.length > 0 && <p class="mono p-n">{w.data.stats.slice(0, 3).map((s) => `${s.value} ${s.label}`).join('  ·  ')}</p>}
              <span class="mono p-st" data-tone={statusLabel[w.data.status].tone}><i></i>{statusLabel[w.data.status].text}</span>
            </a>
          </li>
        ))}
      </ol>
    </section>

    <section id="experience">
      <h2 class="mono">experience</h2>
      <p class="short">{profile.title} at <a href={profile.company.url} target="_blank" rel="noopener">Selegic India</a>, since 2022. I started there as an intern. B.Tech in Computer Science from MAKAUT.</p>
      <div class="long">
        <p>{profile.title} at <a href={profile.company.url} target="_blank" rel="noopener">Selegic India</a>, Jan 2022 to now.</p>
        <ol class="path">
          {milestones.map((m, i) => (
            <li class:list={{ now: i === milestones.length - 1 }}><span class="mono when">{m.when}</span><span class="dot" aria-hidden="true"></span><span><span class="ink">{m.what}</span> <span class="muted">{m.detail}</span></span></li>
          ))}
        </ol>
        <p class="muted">B.Tech, Computer Science, Maulana Abul Kalam Azad University of Technology, {education.years}. CGPA {education.cgpa}.</p>
      </div>
    </section>

    <section id="now">
      <h2 class="mono">now</h2>
      <p class="short">It's <Clock client:load variant="hero" /> in Kolkata.{sum && <> I made <span class="ink">{contrib!.total.toLocaleString('en-US')} contributions</span> on GitHub this year <span class="sp" set:html={spark} />.</>}</p>
      <div class="long">
        <p>It's <Clock client:load variant="hero" /> in Kolkata.</p>
        {sum && <p>I made <span class="ink">{contrib!.total.toLocaleString('en-US')} contributions</span> on GitHub in the last year <span class="sp" set:html={spark} />, most of them in private company repos. The longest streak was {sum.longestStreak} days.</p>}
        <p>Things I reach for: {stackIcons.map((s, i) => <span class="tool"><Brand name={s.icon} size={13} />{s.label}{i < stackIcons.length - 1 ? ',' : '.'}</span>)}</p>
        <p>Writing, slowly: {writing.map((p, i) => <><a href={`/writing/${p.id}`}>{p.data.title}</a><span class="badge mini">draft</span>{i < writing.length - 1 ? ' · ' : ''}</>)}</p>
      </div>
    </section>

    <section id="pipeline" class="long">
      <h2 class="mono">play</h2>
      <p class="muted">A toy version of what I build. Drag a deal to the next stage and close it.</p>
      <Pipeline client:visible />
    </section>

    <section id="contact">
      <h2 class="mono">say hi</h2>
      <p>If you're building something that needs a backend owned end to end, write to me: <CopyEmail client:visible email={profile.email} />.</p>
    </section>
  </article>
</Base>

<style>
  .note { max-width: 640px; margin: 0 auto; padding: 108px 24px 56px; }
  .head { display: flex; align-items: flex-end; gap: 22px; }
  :global(.face pre) { font-size: 2.7px !important; }
  .hello { margin: 0; color: var(--muted); font-size: 0.75rem; }
  h1 { margin-top: 8px; font-size: 2rem; font-weight: 600; letter-spacing: -0.04em; line-height: 1.1; }
  .links { display: flex; align-items: center; gap: 14px; margin-top: 12px; }
  .links a { color: var(--muted); transition: color 0.15s; }
  .links a:hover { color: var(--ink); }
  .cv { margin-left: 4px; text-decoration: none; font-size: 0.75rem; }

  .switch { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; margin: 40px 0 8px; }
  .hint { font-size: 0.6875rem; color: var(--muted); }

  section { margin-top: 44px; }
  h2 { font-size: 0.75rem; font-weight: 500; color: var(--muted); margin-bottom: 10px; }
  h2::before { content: '§ '; color: var(--rule-strong); }
  p { margin: 0 0 14px; font-size: 1.0625rem; line-height: 1.75; color: var(--text); }
  section a:not(.w):not(.go) { color: var(--ink); text-decoration-color: var(--rule-strong); text-underline-offset: 3px; }
  .ink { color: var(--ink); }

  /* tl;dr vs the long version */
  :global(html[data-depth='short']) .long, :global(html:not([data-depth])) .long { display: none; }
  :global(html[data-depth='long']) .short { display: none; }

  .projects { list-style: none; margin: 0; padding: 0; display: grid; gap: 4px; }
  .projects a { display: grid; gap: 4px; padding: 14px 16px; margin: 0 -16px; border-radius: 14px; text-decoration: none; transition: background 0.2s; }
  .projects a:hover { background: var(--surface); }
  .projects p { margin: 0; font-size: 0.9375rem; line-height: 1.6; }
  .p-head { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; }
  .p-t { color: var(--ink); font-weight: 600; letter-spacing: -0.015em; }
  .p-m, .p-n { font-size: 0.6875rem !important; color: var(--muted) !important; }
  .p-st { display: inline-flex; align-items: center; gap: 6px; font-size: 0.6875rem; color: var(--muted); }
  .p-st i { width: 6px; height: 6px; border-radius: 50%; background: var(--muted); }
  .p-st[data-tone='ok'] i { background: var(--ok); } .p-st[data-tone='pilot'] i { background: var(--accent); }

  .path { list-style: none; margin: 4px 0 18px; padding: 0; }
  .path li { display: grid; grid-template-columns: 70px 14px 1fr; gap: 10px; align-items: baseline; padding: 4px 0; position: relative; font-size: 0.9375rem; line-height: 1.5; color: var(--text); }
  .path li::before { content: ''; position: absolute; left: 86px; top: 0; bottom: 0; width: 1px; background: var(--rule-strong); }
  .path li:first-child::before { top: 50%; } .path li:last-child::before { bottom: 50%; }
  .when { font-size: 0.6875rem; color: var(--muted); }
  .dot { position: relative; z-index: 1; width: 9px; height: 9px; border-radius: 50%; background: var(--paper); border: 2px solid var(--rule-strong); justify-self: center; }
  .now .dot { background: var(--accent); border-color: var(--accent); }

  .sp { color: var(--accent); display: inline-block; vertical-align: middle; margin: 0 2px; }
  .sp :global(.spark) { display: block; }
  .tool { display: inline-flex; align-items: center; gap: 5px; margin-right: 8px; white-space: nowrap; }
  .tool :global(svg) { filter: grayscale(1) opacity(0.8); }
  .mini { font-size: 0.5625rem; padding: 0 6px; margin-left: 6px; vertical-align: 2px; }

  @media (max-width: 760px) {
    .note { padding: 80px 16px 40px; }
    .head { flex-direction: column; align-items: flex-start; }
    h1 { font-size: 1.75rem; font-weight: 700; }
    p { font-size: 1rem; }
  }
</style>
